    tooltip="Also draw the previous weekly highs and lows on a monthly chart. Levels and takes come from the weekly candles, so with Stop at take a line ends at the monthly candle containing the week that took it.")

string GD = "Daily"
bool   d_on   = input.bool(true, "Daily", group=GD, display=display.none, inline="d0")
int    d_keep = input.int(3, "Show Last:", minval=1, maxval=12, group=GD, display=display.none, inline="d0",
    tooltip="Highs and lows of the last completed trading days, labelled with the trading date, e.g. 'Mon 09/28 Daily High'. For CME futures the session that opens Sunday 18:00 New York is Monday's. Shown on every timeframe up to daily.")
color  d_lcol = input.color(#2962FF, "High Line", group=GD, display=display.none, inline="d1")
string d_lsty = input.string("Solid", "", options=["Solid","Dashed","Dotted"], group=GD, display=display.none, inline="d1")
