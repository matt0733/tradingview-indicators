//@version=6
indicator("Key Levels 1.13.1", shorttitle="Key Levels", overlay=true,
          max_lines_count=500, max_labels_count=500)

// ===========================================================================
// INPUTS - GENERAL
// ===========================================================================
string GEN = "General"
int    lbl_off  = input.int(10, "Label Offset (bars)", minval=0, maxval=500, group=GEN, display=display.none,
    tooltip="How far past the current bar the labels sit. Untaken lines run to their label. To sit after Opening Gaps' labels, use its Extend Right plus about 15 (the width of its text at normal zoom).")
bool   show_px  = input.bool(true, "Show Price in Label", group=GEN, display=display.none)
float  lbl_gap  = input.float(2.0, "Label Spacing (% of view)", minval=0, maxval=20, step=0.5, group=GEN, display=display.none,
    tooltip="Roughly the height of one label, as a share of the chart's visible price range. Labels closer together than this are spaced out evenly around their prices, each joined to its own line by a short leader. The visible range is re-measured as you zoom and scroll. Raise it if labels still touch, lower it if they spread out when they don't need to.")

// ===========================================================================
// INPUTS - LEVELS
// ===========================================================================
string GM = "Monthly"
bool   m_on   = input.bool(true, "Monthly", group=GM, display=display.none, inline="m0")
int    m_keep = input.int(3, "Show Last:", minval=1, maxval=12, group=GM, display=display.none, inline="m0",
    tooltip="Highs and lows of the last completed months, labelled by month and year, e.g. 'September 2026 Monthly High'. Shown on every timeframe up to monthly.")
color  m_lcol = input.color(#2962FF, "High Line", group=GM, display=display.none, inline="m1")
string m_lsty = input.string("Solid", "", options=["Solid","Dashed","Dotted"], group=GM, display=display.none, inline="m1")
int    m_lw   = input.int(1, "", minval=1, maxval=10, group=GM, display=display.none, inline="m1")
color  m_tcol = input.color(#2962FF, "High Text", group=GM, display=display.none, inline="m2")
string m_tsz  = input.string("Small", "", options=["Tiny","Small","Normal","Large"], group=GM, display=display.none, inline="m2")
bool   m_tb   = input.bool(true, "Bold", group=GM, display=display.none, inline="m2")
color  m_lcol2 = input.color(#B22833, "Low Line", group=GM, display=display.none, inline="m3")
string m_lsty2 = input.string("Solid", "", options=["Solid","Dashed","Dotted"], group=GM, display=display.none, inline="m3")
int    m_lw2   = input.int(1, "", minval=1, maxval=10, group=GM, display=display.none, inline="m3")
color  m_tcol2 = input.color(#B22833, "Low Text", group=GM, display=display.none, inline="m4")
string m_tsz2  = input.string("Small", "", options=["Tiny","Small","Normal","Large"], group=GM, display=display.none, inline="m4")
bool   m_tb2   = input.bool(true, "Bold", group=GM, display=display.none, inline="m4")
string m_take = input.string("Keep", "When Taken", options=["Keep","Stop at take","Remove"], group=GM, display=display.none,
    tooltip="What happens once price trades through one of these levels (a wick touch counts). Keep: the line runs on to its label. Stop at take: the line ends at the candle that took it and the label moves to the middle of the line - above it for highs, below it for lows. Remove: the line and label are deleted.")

string GW = "Weekly"
bool   w_on   = input.bool(true, "Weekly", group=GW, display=display.none, inline="w0")
int    w_keep = input.int(1, "Show Last:", minval=1, maxval=12, group=GW, display=display.none, inline="w0",
    tooltip="Highs and lows of the last completed weeks, labelled 'Previous Weekly High' / 'Previous Weekly Low' for the last completed week; older weeks add the date the week opened (Sunday evening for CME futures), e.g. '09/27 Previous Weekly High'. Shown on every timeframe up to weekly.")
color  w_lcol = input.color(#2962FF, "High Line", group=GW, display=display.none, inline="w1")
