//@version=6
indicator("Chart Label 1.5", shorttitle="Label", overlay=true)

// ===========================================================================
// INPUTS - POSITION & SIZE
// ===========================================================================
string GP = "Position & Size"
string pos_in  = input.string("Lower Center", "Position",
    options=["Upper Left","Upper Center","Upper Right","Lower Left","Lower Center","Lower Right"], group=GP)
string size_in = input.string("Medium", "Size",
    options=["Small","Medium","Large"], group=GP)

// ===========================================================================
// INPUTS - COLORS
// ===========================================================================
string GCOL = "Colors"
color bg_col     = input.color(color.white, "Background",          group=GCOL)
color line1_col  = input.color(color.red,   "Line 1 (Ticker)",     group=GCOL, inline="l1")
bool  line1_bold = input.bool(true,         "Bold",                group=GCOL, inline="l1")
color line2_col  = input.color(color.black, "Line 2 (Timeframe)",  group=GCOL, inline="l2")
bool  line2_bold = input.bool(true,         "Bold",                group=GCOL, inline="l2")
color line3_col  = input.color(color.black, "Line 3 (Day / Date)", group=GCOL, inline="l3")
bool  line3_bold = input.bool(true,         "Bold",                group=GCOL, inline="l3")

// ===========================================================================
// INPUTS - BORDER
// ===========================================================================
string GB = "Border"
bool  show_border = input.bool(true,        "Show Border",       group=GB)
color border_col  = input.color(color.black,"Border Color",      group=GB)
int   border_w    = input.int(2,            "Border Thickness",  minval=1, maxval=5, group=GB)

// ===========================================================================
// HELPERS
// ===========================================================================
tfString() =>
    m = timeframe.multiplier
    timeframe.isseconds ? str.tostring(m) + "s" :
      timeframe.isminutes ? (m >= 60 and m % 60 == 0 ? str.tostring(m / 60) + "h" : str.tostring(m) + "m") :
      timeframe.isdaily   ? str.tostring(m) + "d" :
      timeframe.isweekly  ? str.tostring(m) + "w" :
      timeframe.ismonthly ? str.tostring(m) + "Mo" : timeframe.period

dayName(int d) =>
    switch d
        1 => "SUN"
        2 => "MON"
        3 => "TUE"
        4 => "WED"
        5 => "THU"
        6 => "FRI"
        7 => "SAT"
        => ""

posOf(string s) =>
    switch s
        "Upper Left"    => position.top_left
        "Upper Center"  => position.top_center
        "Upper Right"   => position.top_right
        "Lower Left"    => position.bottom_left
        "Lower Center"  => position.bottom_center
        "Lower Right"   => position.bottom_right
        => position.top_right

sizeOf(string s) =>
    switch s
        "Small"  => size.small
        "Medium" => size.normal
        "Large"  => size.large
        => size.normal

fmtOf(bool b) =>
    b ? text.format_bold : text.format_none

// ===========================================================================
// RENDER
// ===========================================================================
var table t = na

if barstate.islast
    if not na(t)
        table.delete(t)

    tz     = syminfo.timezone
    dow    = dayName(dayofweek(time, tz))
    dt     = str.format_time(time, "MM/dd/yy", tz)
    tf_str = tfString()

    line1 = syminfo.ticker
    line2 = tf_str
    line3 = dow + " " + dt

    txt_size = sizeOf(size_in)
    frame_w  = show_border ? border_w : 0

    t := table.new(posOf(pos_in), 1, 3,
         bgcolor      = bg_col,
         border_width = 0,
         frame_width  = frame_w,
         frame_color  = border_col)

    table.cell(t, 0, 0, line1, text_color=line1_col, text_size=txt_size, bgcolor=bg_col, text_formatting=fmtOf(line1_bold))
    table.cell(t, 0, 1, line2, text_color=line2_col, text_size=txt_size, bgcolor=bg_col, text_formatting=fmtOf(line2_bold))
    table.cell(t, 0, 2, line3, text_color=line3_col, text_size=txt_size, bgcolor=bg_col, text_formatting=fmtOf(line3_bold))

// Force overlay onto main pane (Pine puts table-only scripts in their own pane otherwise)
plot(na, display=display.none, editable=false)
