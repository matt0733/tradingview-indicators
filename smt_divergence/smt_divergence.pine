//@version=6
// SMT Divergence 2.0.0
//
// 2.0.0
//   - Rewritten from scratch. Uses the standard SMT definition: compare the last two swing
//     highs (or lows) in each market. If one market takes its previous swing and the other
//     does not, that is an SMT. Version 1 instead searched every older swing within the span
//     for any divergence, which fired about 38 times a day on 1 minute MNQ.
//   - Measured on 1 minute MNQ against ES and YM, Sept 10 to 30 2026: about 7 signals a day
//     at a 58.5% hit rate, against 51.2% for the same swings with no SMT condition, and a
//     positive edge in each of the three weeks. Version 1 on the same data: 38 a day at 53.6%.
//     Swing Length 5 was picked from a small grid on that same data, so forward results are
//     the real test.
//   - Signals are only evaluated on closed bars, so they never appear and then vanish intrabar.
//   - Invalidated SMTs fade by default instead of being deleted, so chart history shows the
//     misses as well as the hits.
//   - One line per pair of swings. When both comparison markets diverge on the same swings,
//     the label names both.
//   - Optional session filter and alerts.
indicator(title = "SMT Divergence 2.0.0", shorttitle = "SMT", overlay = true, max_lines_count = 500, max_labels_count = 500)

// -- Inputs ----------------------------------------------------------------------------------
string GC = "Comparison"
i_use1 = input.bool(true, "Symbol 1", inline = "c1", group = GC)
i_sym1 = input.symbol("CME_MINI:ES1!", "", inline = "c1", group = GC)
i_inv1 = input.bool(false, "Inverse", inline = "c1", group = GC, tooltip = "Tick when this market normally moves opposite to the chart. Chart highs are then compared with its lows, and chart lows with its highs.")
i_use2 = input.bool(true, "Symbol 2", inline = "c2", group = GC)
i_sym2 = input.symbol("CBOT_MINI:YM1!", "", inline = "c2", group = GC)
i_inv2 = input.bool(false, "Inverse", inline = "c2", group = GC, tooltip = "Tick when this market normally moves opposite to the chart. Chart highs are then compared with its lows, and chart lows with its highs.")

string GD = "Detection"
i_len = input.int(5, "Swing Length", minval = 2, maxval = 20, group = GD, tooltip = "Bars required on each side of a swing high or low. Larger values mean fewer, more significant swings. On 1 minute MNQ, 5 tested clearly better than 3 or 8.")
i_sync = input.int(2, "Sync Tolerance", minval = 0, maxval = 5, group = GD, tooltip = "How many bars apart the matching swings in the two markets may be.")
i_span = input.int(30, "Max SMT Span", minval = 5, maxval = 500, group = GD, tooltip = "Maximum bars between the two swings being compared.")
i_minDiv = input.float(1.0, "Min Divergence (ATR)", minval = 0.0, maxval = 5.0, step = 0.1, group = GD, tooltip = "How far the comparison market's two swings must differ, in its own ATR(14). Filters out misses of a tick or two, which are noise rather than a liquidity event. 0 turns the filter off.")

string GS = "Session Filter"
i_sessMode = input.string("All", "Show SMTs during", options = ["All", "NY AM", "London", "NY AM + London", "Custom"], group = GS, tooltip = "Only draw SMTs that complete inside these hours (New York time). NY AM is 09:30-11:00 and London is 02:00-05:00.")
i_sessCustom = input.session("0930-1100", "Custom session", group = GS, tooltip = "New York time. Used when Show SMTs during is set to Custom.")

string GV = "Display"
i_maxShow = input.int(10, "Max SMTs shown", minval = 1, maxval = 200, group = GV, tooltip = "Older SMTs are removed first.")
i_onInval = input.string("Fade", "When invalidated", options = ["Fade", "Delete", "Keep"], group = GV, tooltip = "A bearish SMT is invalidated when price closes above its highest swing, a bullish one when price closes below its lowest. Fade keeps it visible but dimmed, so history shows the misses as well as the hits. Delete removes it, which makes history look more accurate than it was live.")
i_bearCol = input.color(color.red, "Bearish", inline = "col", group = GV)
i_bullCol = input.color(color.blue, "Bullish", inline = "col", group = GV)
i_style = input.string("Dashed", "Line", options = ["Solid", "Dashed", "Dotted"], inline = "ln", group = GV)
i_width = input.int(1, "", minval = 1, maxval = 4, inline = "ln", group = GV)
i_txtSize = input.string("Small", "Text", options = ["Tiny", "Small", "Normal", "Large"], inline = "tx", group = GV)
i_txtCol = input.color(color.black, "", inline = "tx", group = GV)

// -- Constants -------------------------------------------------------------------------------
lineStyle = switch i_style
    "Solid" => line.style_solid
    "Dotted" => line.style_dotted
    => line.style_dashed

txtSize = switch i_txtSize
    "Tiny" => size.tiny
    "Normal" => size.normal
    "Large" => size.large
    => size.small

float txtMult = switch i_txtSize
    "Tiny" => 0.7
    "Normal" => 1.35
    "Large" => 1.9
    => 1.0

string sessStr = switch i_sessMode
    "NY AM" => "0930-1100"
    "London" => "0200-0500"
    "NY AM + London" => "0200-0500,0930-1100"
    "Custom" => i_sessCustom
    => "0000-0000"

symbolLabel(string sym) =>
    array<string> parts = str.split(sym, ":")
    array.size(parts) > 1 ? array.get(parts, array.size(parts) - 1) : sym

// -- Data ------------------------------------------------------------------------------------
// A disabled symbol requests the chart's own ticker so it can never break the script.
string req1 = i_use1 ? i_sym1 : syminfo.tickerid
string req2 = i_use2 ? i_sym2 : syminfo.tickerid
[h1, l1, atr1] = request.security(req1, timeframe.period, [high, low, ta.atr(14)], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[h2, l2, atr2] = request.security(req2, timeframe.period, [high, low, ta.atr(14)], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
float chartAtr = nz(ta.atr(14), high - low)
string tag1 = symbolLabel(i_sym1)
string tag2 = symbolLabel(i_sym2)
bool inSession = i_sessMode == "All" or not na(time(timeframe.period, sessStr, "America/New_York"))

// Swings must be computed on every bar, outside any condition.
float chPH = ta.pivothigh(high, i_len, i_len)
float chPL = ta.pivotlow(low, i_len, i_len)
float s1PH = ta.pivothigh(h1, i_len, i_len)
float s1PL = ta.pivotlow(l1, i_len, i_len)
float s2PH = ta.pivothigh(h2, i_len, i_len)
float s2PL = ta.pivotlow(l2, i_len, i_len)

// -- State -----------------------------------------------------------------------------------
// The last two confirmed swings of one side (highs or lows) of one market.
type Swings
    float prev = na
    int prevBar = na
    float last = na
    int lastBar = na

method push(Swings s, float px, int b) =>
    s.prev := s.last
    s.prevBar := s.lastBar
    s.last := px
    s.lastBar := b

type SMT
    line ln
    label lb
    bool bear
    int barA
    int barB
    float inval
    string tags
    bool dead = false

var Swings chH = Swings.new()
var Swings chL = Swings.new()
var Swings c1H = Swings.new()
var Swings c1L = Swings.new()
var Swings c2H = Swings.new()
var Swings c2L = Swings.new()
var array<SMT> smts = array.new<SMT>()
var array<string> seenKeys = array.new<string>()

// -- Logic -----------------------------------------------------------------------------------
// Compares the chart's last two swings with the comparison market's last two. Returns true
// when a new SMT line is drawn.
evalSMT(Swings ch, Swings cp, bool bear, bool inv, float compAtr, string tag) =>
    bool isNew = false
    if not na(ch.prevBar) and not na(cp.prevBar)
        bool paired = math.abs(ch.lastBar - cp.lastBar) <= i_sync and math.abs(ch.prevBar - cp.prevBar) <= i_sync
        int span = ch.lastBar - ch.prevBar
        if paired and span > 0 and span <= i_span
            bool chartTook = bear ? ch.last > ch.prev : ch.last < ch.prev
            bool compTook = inv ? (bear ? cp.last < cp.prev : cp.last > cp.prev) : (bear ? cp.last > cp.prev : cp.last < cp.prev)
            if chartTook != compTook and math.abs(cp.last - cp.prev) >= i_minDiv * nz(compAtr, 0.0)
                string key = (bear ? "B" : "L") + str.tostring(ch.prevBar) + "_" + str.tostring(ch.lastBar)
                if array.includes(seenKeys, key)
                    // Already drawn from the other comparison market: add this market's name.
                    for s in smts
                        if s.bear == bear and s.barA == ch.prevBar and s.barB == ch.lastBar and not str.contains(s.tags, tag)
                            s.tags := s.tags + "/" + tag
                            label.set_text(s.lb, s.tags)
                else
                    array.push(seenKeys, key)
                    if array.size(seenKeys) > 500
                        array.shift(seenKeys)
                    color col = bear ? i_bearCol : i_bullCol
                    int mid = int(math.round((ch.prevBar + ch.lastBar) / 2.0))
                    float atMid = ch.prev + (ch.last - ch.prev) * (mid - ch.prevBar) / span
                    float off = chartAtr * 0.24 * txtMult
                    line ln = line.new(ch.prevBar, ch.prev, ch.lastBar, ch.last, xloc = xloc.bar_index, color = col, style = lineStyle, width = i_width)
                    label lb = label.new(mid, bear ? atMid + off : atMid - off, tag, xloc = xloc.bar_index, style = label.style_none, color = color.new(color.white, 100), textcolor = i_txtCol, size = txtSize)
                    array.push(smts, SMT.new(ln, lb, bear, ch.prevBar, ch.lastBar, bear ? math.max(ch.prev, ch.last) : math.min(ch.prev, ch.last), tag))
                    if array.size(smts) > i_maxShow
                        SMT old = array.shift(smts)
                        line.delete(old.ln)
                        label.delete(old.lb)
                    alert((bear ? "Bearish" : "Bullish") + " SMT on " + syminfo.ticker + " vs " + tag, alert.freq_once_per_bar_close)
                    isNew := true
    isNew

bool newBear = false
bool newBull = false

// Only closed bars are evaluated, so a signal can never appear intrabar and then disappear.
if barstate.isconfirmed
    int p = bar_index - i_len
    if not na(chPH)
        chH.push(chPH, p)
    if not na(chPL)
        chL.push(chPL, p)
    if not na(s1PH)
        c1H.push(s1PH, p)
    if not na(s1PL)
        c1L.push(s1PL, p)
    if not na(s2PH)
        c2H.push(s2PH, p)
    if not na(s2PL)
        c2L.push(s2PL, p)

    if inSession
        if i_use1
            if not na(chPH) or not na(i_inv1 ? s1PL : s1PH)
                newBear := evalSMT(chH, i_inv1 ? c1L : c1H, true, i_inv1, atr1, tag1) or newBear
            if not na(chPL) or not na(i_inv1 ? s1PH : s1PL)
                newBull := evalSMT(chL, i_inv1 ? c1H : c1L, false, i_inv1, atr1, tag1) or newBull
        if i_use2
            if not na(chPH) or not na(i_inv2 ? s2PL : s2PH)
                newBear := evalSMT(chH, i_inv2 ? c2L : c2H, true, i_inv2, atr2, tag2) or newBear
            if not na(chPL) or not na(i_inv2 ? s2PH : s2PL)
                newBull := evalSMT(chL, i_inv2 ? c2H : c2L, false, i_inv2, atr2, tag2) or newBull

    // Invalidation: a bearish SMT fails when price closes above its highest swing.
    int n = array.size(smts)
    if n > 0
        for i = n - 1 to 0
            SMT s = array.get(smts, i)
            if not s.dead and (s.bear ? close > s.inval : close < s.inval)
                s.dead := true
                if i_onInval == "Delete"
                    line.delete(s.ln)
                    label.delete(s.lb)
                    array.remove(smts, i)
                else if i_onInval == "Fade"
                    line.set_color(s.ln, color.new(s.bear ? i_bearCol : i_bullCol, 75))
                    label.set_textcolor(s.lb, color.new(i_txtCol, 75))

alertcondition(newBear, "Bearish SMT", "Bearish SMT divergence")
alertcondition(newBull, "Bullish SMT", "Bullish SMT divergence")
