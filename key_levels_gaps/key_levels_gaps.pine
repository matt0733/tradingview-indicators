//@version=6
indicator("Key Levels + Gaps 1.0.8", shorttitle="Key Levels + Gaps", overlay=true,
          max_lines_count=500, max_labels_count=500)

// Key Levels and Opening Gaps in one script. Two scripts can't see each other's
// labels, so they wrote over each other; here every label goes through one spacing
// pass in one column.

// ===========================================================================
// INPUTS - GENERAL
// ===========================================================================
string GEN = "General"
bool   kl_on    = input.bool(true, "Key Levels", group=GEN, display=display.none,
    tooltip="Everything in the Monthly, Weekly, Daily, Opens, Premarket and Midnight Open sections.")
bool   og_on    = input.bool(true, "Opening Gaps", group=GEN, display=display.none,
    tooltip="Everything in the NWOG, NDOG and RTH Gap sections.")
int    lbl_off  = input.int(10, "Label Offset (bars)", minval=0, maxval=500, group=GEN, display=display.none,
    tooltip="How far past the current bar the labels sit, for every level and gap. Untaken lines run to their label.")
bool   show_px  = input.bool(true, "Show Price in Label", group=GEN, display=display.none,
    tooltip="Key Levels' labels only.")
bool   spread_on = input.bool(true, "Spread Overlapping Labels", group=GEN, display=display.none,
    tooltip="When labels sit closer than the spacing below, space them out evenly around their prices, each joined to its own line by a short leader. Turn off to leave every label level with its line.")
float  lbl_gap  = input.float(2.0, "Label Spacing (% of view)", minval=0, maxval=20, step=0.5, group=GEN, display=display.none,
    tooltip="Roughly the height of one label, as a share of the chart's visible price range. Labels closer together than this are spaced out evenly around their prices. The visible range is re-measured as you zoom and scroll. Raise it if labels still touch, lower it if they spread out when they don't need to.")
int    max_move = input.int(0, "Max Label Move (label heights)", minval=0, maxval=20, group=GEN, display=display.none,
    tooltip="0 = no limit. A label that would have to move further than this many label heights stays on its own line instead, even if it then touches another label.")
bool   crowd_off = input.bool(false, "Skip Spread When Crowded", group=GEN, display=display.none,
    tooltip="When more labels are in view than fit at the Label Spacing, leave every label on its own line instead of spreading them.")

// ===========================================================================
// INPUTS - LEVELS
// ===========================================================================
string GM = "Monthly"
bool   m_on   = input.bool(true, "Monthly", group=GM, display=display.none, inline="m0")
int    m_keep = input.int(3, "Show Last:", minval=1, maxval=12, group=GM, display=display.none, inline="m0",
    tooltip="Highs and lows of the last completed months, labelled by month and year, e.g. 'September 2026 Monthly High'. Shown on every timeframe up to monthly.")
color  m_lcol = input.color(#2962FF, "High Line", group=GM, display=display.none, inline="m1")
string m_lsty = input.string("Solid", "", options=["Solid","Dashed","Dotted"], group=GM, display=display.none, inline="m1")
int    m_lw   = input.int(2, "", minval=1, maxval=10, group=GM, display=display.none, inline="m1")
color  m_tcol = input.color(#2962FF, "High Text", group=GM, display=display.none, inline="m2")
string m_tsz  = input.string("Small", "", options=["Tiny","Small","Normal","Large"], group=GM, display=display.none, inline="m2")
bool   m_tb   = input.bool(true, "Bold", group=GM, display=display.none, inline="m2")
color  m_lcol2 = input.color(#801922, "Low Line", group=GM, display=display.none, inline="m3")
string m_lsty2 = input.string("Solid", "", options=["Solid","Dashed","Dotted"], group=GM, display=display.none, inline="m3")
int    m_lw2   = input.int(2, "", minval=1, maxval=10, group=GM, display=display.none, inline="m3")
color  m_tcol2 = input.color(#801922, "Low Text", group=GM, display=display.none, inline="m4")
string m_tsz2  = input.string("Small", "", options=["Tiny","Small","Normal","Large"], group=GM, display=display.none, inline="m4")
bool   m_tb2   = input.bool(true, "Bold", group=GM, display=display.none, inline="m4")
string m_take = input.string("Keep", "When Taken", options=["Keep","Stop at take","Remove"], group=GM, display=display.none,
    tooltip="What happens once price trades through one of these levels (a wick touch counts). Keep: the line runs on to its label. Stop at take: the line ends at the candle that took it and the label moves to the middle of the line - above it for highs, below it for lows. Remove: the line and label are deleted.")

string GW = "Weekly"
bool   w_on   = input.bool(true, "Weekly", group=GW, display=display.none, inline="w0")
int    w_keep = input.int(1, "Show Last:", minval=1, maxval=12, group=GW, display=display.none, inline="w0",
    tooltip="Highs and lows of the last completed weeks, labelled 'Previous Weekly High' / 'Previous Weekly Low' for the last completed week; older weeks add the date the week opened (Sunday evening for CME futures), e.g. '09/27 Previous Weekly High'. Shown on every timeframe up to weekly.")
color  w_lcol = input.color(#2962FF, "High Line", group=GW, display=display.none, inline="w1")
string w_lsty = input.string("Dotted", "", options=["Solid","Dashed","Dotted"], group=GW, display=display.none, inline="w1")
int    w_lw   = input.int(2, "", minval=1, maxval=10, group=GW, display=display.none, inline="w1")
color  w_tcol = input.color(#2962FF, "High Text", group=GW, display=display.none, inline="w2")
string w_tsz  = input.string("Small", "", options=["Tiny","Small","Normal","Large"], group=GW, display=display.none, inline="w2")
bool   w_tb   = input.bool(true, "Bold", group=GW, display=display.none, inline="w2")
color  w_lcol2 = input.color(#801922, "Low Line", group=GW, display=display.none, inline="w3")
string w_lsty2 = input.string("Dotted", "", options=["Solid","Dashed","Dotted"], group=GW, display=display.none, inline="w3")
int    w_lw2   = input.int(2, "", minval=1, maxval=10, group=GW, display=display.none, inline="w3")
color  w_tcol2 = input.color(#801922, "Low Text", group=GW, display=display.none, inline="w4")
string w_tsz2  = input.string("Small", "", options=["Tiny","Small","Normal","Large"], group=GW, display=display.none, inline="w4")
bool   w_tb2   = input.bool(true, "Bold", group=GW, display=display.none, inline="w4")
string w_take = input.string("Keep", "When Taken", options=["Keep","Stop at take","Remove"], group=GW, display=display.none,
    tooltip="What happens once price trades through one of these levels (a wick touch counts). Keep: the line runs on to its label. Stop at take: the line ends at the candle that took it and the label moves to the middle of the line - above it for highs, below it for lows. Remove: the line and label are deleted.")
bool   w_on_m = input.bool(true, "Show on Monthly Chart", group=GW, display=display.none,
    tooltip="Also draw the previous weekly highs and lows on a monthly chart. Levels and takes come from the weekly candles, so with Stop at take a line ends at the monthly candle containing the week that took it.")

string GD = "Daily"
bool   d_on   = input.bool(true, "Daily", group=GD, display=display.none, inline="d0")
int    d_keep = input.int(3, "Show Last:", minval=1, maxval=12, group=GD, display=display.none, inline="d0",
    tooltip="Highs and lows of the last completed trading days, labelled with the trading date, e.g. 'Mon 09/28 Daily High'. For CME futures the session that opens Sunday 18:00 New York is Monday's. Shown on every timeframe up to daily.")
color  d_lcol = input.color(#2962FF, "High Line", group=GD, display=display.none, inline="d1")
string d_lsty = input.string("Solid", "", options=["Solid","Dashed","Dotted"], group=GD, display=display.none, inline="d1")
int    d_lw   = input.int(1, "", minval=1, maxval=10, group=GD, display=display.none, inline="d1")
color  d_tcol = input.color(#2962FF, "High Text", group=GD, display=display.none, inline="d2")
string d_tsz  = input.string("Small", "", options=["Tiny","Small","Normal","Large"], group=GD, display=display.none, inline="d2")
bool   d_tb   = input.bool(true, "Bold", group=GD, display=display.none, inline="d2")
color  d_lcol2 = input.color(#801922, "Low Line", group=GD, display=display.none, inline="d3")
string d_lsty2 = input.string("Solid", "", options=["Solid","Dashed","Dotted"], group=GD, display=display.none, inline="d3")
int    d_lw2   = input.int(1, "", minval=1, maxval=10, group=GD, display=display.none, inline="d3")
color  d_tcol2 = input.color(#801922, "Low Text", group=GD, display=display.none, inline="d4")
string d_tsz2  = input.string("Small", "", options=["Tiny","Small","Normal","Large"], group=GD, display=display.none, inline="d4")
bool   d_tb2   = input.bool(true, "Bold", group=GD, display=display.none, inline="d4")
string d_take = input.string("Keep", "When Taken", options=["Keep","Stop at take","Remove"], group=GD, display=display.none,
    tooltip="What happens once price trades through one of these levels (a wick touch counts). Keep: the line runs on to its label. Stop at take: the line ends at the candle that took it and the label moves to the middle of the line - above it for highs, below it for lows. Remove: the line and label are deleted.")

// ===========================================================================
// INPUTS - OPENS
// ===========================================================================
string GO = "Opens"
bool   mo_on   = input.bool(true, "Monthly Open", group=GO, display=display.none, inline="mo0")
int    mo_prev = input.int(3, "Previous:", minval=0, maxval=12, group=GO, display=display.none, inline="mo0",
    tooltip="The current month's opening price, plus up to 12 previous months, labelled by month and year, e.g. 'October 2026 Opening Price'. A futures month starts at its first session, so October opens Sep 30 18:00 New York. Shown on every timeframe. Opens always run to their label, even after price trades through them.")
color  mo_lcol = input.color(#000000, "Line", group=GO, display=display.none, inline="mo1")
string mo_lsty = input.string("Dashed", "", options=["Solid","Dashed","Dotted"], group=GO, display=display.none, inline="mo1")
int    mo_lw   = input.int(1, "", minval=1, maxval=10, group=GO, display=display.none, inline="mo1")
color  mo_tcol = input.color(#000000, "Text", group=GO, display=display.none, inline="mo2")
string mo_tsz  = input.string("Small", "", options=["Tiny","Small","Normal","Large"], group=GO, display=display.none, inline="mo2")
bool   mo_tb   = input.bool(true, "Bold", group=GO, display=display.none, inline="mo2")

bool   wo_on   = input.bool(true, "Weekly Open", group=GO, display=display.none,
    tooltip="The current week's opening price, labelled 'Weekly Open'. For CME futures the week opens Sunday 18:00 New York. The line starts on the week's first candle. Shown on weekly and lower timeframes. Always runs to its label, even after price trades through it.")
color  wo_lcol = input.color(#000000, "Line", group=GO, display=display.none, inline="wo1")
string wo_lsty = input.string("Dashed", "", options=["Solid","Dashed","Dotted"], group=GO, display=display.none, inline="wo1")
int    wo_lw   = input.int(1, "", minval=1, maxval=10, group=GO, display=display.none, inline="wo1")
color  wo_tcol = input.color(#000000, "Text", group=GO, display=display.none, inline="wo2")
string wo_tsz  = input.string("Small", "", options=["Tiny","Small","Normal","Large"], group=GO, display=display.none, inline="wo2")
bool   wo_tb   = input.bool(true, "Bold", group=GO, display=display.none, inline="wo2")
bool   wo_on_m = input.bool(true, "Show Weekly Open on Monthly Chart", group=GO, display=display.none,
    tooltip="Also draw the current Weekly Open on a monthly chart. The line starts on the month containing the week's open.")

bool   mc_on   = input.bool(true, "Monthly Close", group=GO, display=display.none, inline="mc0")
int    mc_prev = input.int(3, "Previous:", minval=0, maxval=12, group=GO, display=display.none, inline="mc0",
    tooltip="The last completed month's closing price, plus up to 12 earlier months, labelled by month and year, e.g. 'September 2026 Closing Price'. The line starts on the month's last candle. Shown on every timeframe. Closes always run to their label, even after price trades through them.")
color  mc_lcol = input.color(#000000, "Line", group=GO, display=display.none, inline="mc1")
string mc_lsty = input.string("Dashed", "", options=["Solid","Dashed","Dotted"], group=GO, display=display.none, inline="mc1")
int    mc_lw   = input.int(1, "", minval=1, maxval=10, group=GO, display=display.none, inline="mc1")
color  mc_tcol = input.color(#000000, "Text", group=GO, display=display.none, inline="mc2")
string mc_tsz  = input.string("Small", "", options=["Tiny","Small","Normal","Large"], group=GO, display=display.none, inline="mc2")
bool   mc_tb   = input.bool(true, "Bold", group=GO, display=display.none, inline="mc2")

bool   pc_on   = input.bool(true, "Previous Day Close", group=GO, display=display.none,
    tooltip="The last completed trading day's closing price (the daily candle's close; for CME futures that is the settlement price). The line starts on that day's last candle. Shown on daily and lower timeframes. Always runs to its label, even after price trades through it.")
color  pc_lcol = input.color(#000000, "Line", group=GO, display=display.none, inline="pc1")
string pc_lsty = input.string("Dashed", "", options=["Solid","Dashed","Dotted"], group=GO, display=display.none, inline="pc1")
int    pc_lw   = input.int(1, "", minval=1, maxval=10, group=GO, display=display.none, inline="pc1")
color  pc_tcol = input.color(#000000, "Text", group=GO, display=display.none, inline="pc2")
string pc_tsz  = input.string("Small", "", options=["Tiny","Small","Normal","Large"], group=GO, display=display.none, inline="pc2")
bool   pc_tb   = input.bool(true, "Bold", group=GO, display=display.none, inline="pc2")
string cl_md   = input.string("Settlement", "Close Price", options=["Settlement","Last Trade"], group=GO, display=display.none,
    tooltip="Which price Monthly Close and Previous Day Close use. Settlement: the daily/monthly candle's close (for CME futures the settlement price, set around 16:00 New York); the line starts on the last candle of the period that traded through it, or the closest one if none did. Last Trade: the close of the period's last candle, where the line starts. On daily and higher charts, and for closes older than the loaded history, both use the candle close.")

bool   do_on   = input.bool(true, "Daily Open", group=GO, display=display.none,
    tooltip="The current trading day's opening price, from its first 1-minute candle (for CME futures the session opens 18:00 New York). The line starts on that candle. Shown on daily and lower timeframes, not on range or tick charts. Always runs to its label, even after price trades through it.")
color  do_lcol = input.color(#000000, "Line", group=GO, display=display.none, inline="do1")
string do_lsty = input.string("Dashed", "", options=["Solid","Dashed","Dotted"], group=GO, display=display.none, inline="do1")
int    do_lw   = input.int(1, "", minval=1, maxval=10, group=GO, display=display.none, inline="do1")
color  do_tcol = input.color(#000000, "Text", group=GO, display=display.none, inline="do2")
string do_tsz  = input.string("Small", "", options=["Tiny","Small","Normal","Large"], group=GO, display=display.none, inline="do2")
bool   do_tb   = input.bool(true, "Bold", group=GO, display=display.none, inline="do2")

string GP = "Premarket"
bool   pm_on   = input.bool(true, "Premarket High / Low", group=GP, display=display.none,
    tooltip="The high and low between 07:00 and 09:00 New York, from 1-minute candles. They appear at 07:00 and follow new highs and lows until 09:00, then hold until the next day's 07:00. Lines start on the candle that set each price. Shown on 4-hour and lower timeframes, not on daily and higher, range or tick charts.")
color  pm_lcol = input.color(#F23645, "High Line", group=GP, display=display.none, inline="pm1")
string pm_lsty = input.string("Solid", "", options=["Solid","Dashed","Dotted"], group=GP, display=display.none, inline="pm1")
int    pm_lw   = input.int(1, "", minval=1, maxval=10, group=GP, display=display.none, inline="pm1")
color  pm_tcol = input.color(#F23645, "High Text", group=GP, display=display.none, inline="pm2")
string pm_tsz  = input.string("Small", "", options=["Tiny","Small","Normal","Large"], group=GP, display=display.none, inline="pm2")
bool   pm_tb   = input.bool(true, "Bold", group=GP, display=display.none, inline="pm2")
color  pm_lcol2 = input.color(#F23645, "Low Line", group=GP, display=display.none, inline="pm3")
string pm_lsty2 = input.string("Solid", "", options=["Solid","Dashed","Dotted"], group=GP, display=display.none, inline="pm3")
int    pm_lw2   = input.int(1, "", minval=1, maxval=10, group=GP, display=display.none, inline="pm3")
color  pm_tcol2 = input.color(#F23645, "Low Text", group=GP, display=display.none, inline="pm4")
string pm_tsz2  = input.string("Small", "", options=["Tiny","Small","Normal","Large"], group=GP, display=display.none, inline="pm4")
bool   pm_tb2   = input.bool(true, "Bold", group=GP, display=display.none, inline="pm4")
string pm_take = input.string("Keep", "When Taken", options=["Keep","Stop at take","Remove"], group=GP, display=display.none,
    tooltip="What happens once price trades through the premarket high or low after 09:00 (a wick touch counts). Keep: the line runs on to its label. Stop at take: the line ends at the candle that took it and the label moves to the middle of the line - above it for the high, below it for the low. Remove: the line and label are deleted.")

string GN = "Midnight Open"
bool   mn_on   = input.bool(true, "Midnight Open", group=GN, display=display.none,
    tooltip="The open of today's 00:00 New York candle, from 1-minute data. The line starts on that candle and always runs to its label. Shown on 4-hour and lower timeframes, not on daily and higher, range or tick charts.")
color  mn_lcol = input.color(#000000, "Line", group=GN, display=display.none, inline="mn1")
string mn_lsty = input.string("Dashed", "", options=["Solid","Dashed","Dotted"], group=GN, display=display.none, inline="mn1")
int    mn_lw   = input.int(1, "", minval=1, maxval=10, group=GN, display=display.none, inline="mn1")
color  mn_tcol = input.color(#000000, "Text", group=GN, display=display.none, inline="mn2")
string mn_tsz  = input.string("Small", "", options=["Tiny","Small","Normal","Large"], group=GN, display=display.none, inline="mn2")
bool   mn_tb   = input.bool(true, "Bold", group=GN, display=display.none, inline="mn2")

// ===========================================================================
// INPUTS - NWOG
// ===========================================================================
string GNW = "『 NWOG 』"
bool   nwc_on   = input.bool(true, "Current ▸", group=GNW, display=display.none, inline="nwc0", tooltip="New Week Opening Gap: Friday's 16:59 close to Sunday's 18:00 open (New York time). Quarter and mid levels are measured from the open toward the prior close, so 25% means the gap is a quarter filled.")
color  nwc_lcol = input.color(#673AB7, "Line ▸", group=GNW, display=display.none, inline="nwc1")
string nwc_lsty = input.string("Solid", "", options=["Solid","Dashed","Dotted"], group=GNW, display=display.none, inline="nwc1")
int    nwc_lw   = input.int(2, "", minval=1, maxval=10, group=GNW, display=display.none, inline="nwc1")
color  nwc_tcol = input.color(#673AB7, "Text ▸", group=GNW, display=display.none, inline="nwc2")
string nwc_tsz  = input.string("Small", "", options=["Tiny","Small","Normal","Large"], group=GNW, display=display.none, inline="nwc2")
string nwc_tpos = input.string("Middle", "", options=["Top","Middle","Bottom"], group=GNW, display=display.none, inline="nwc2")
bool   nwc_date = input.bool(true, "Date", group=GNW, display=display.none, inline="nwc2",
    tooltip="Append the date of the gap's open to every label of these gaps, as MM/DD — e.g. 'NWOG High 09/13'.")
bool   nwc_bold = input.bool(true, "Bold", group=GNW, display=display.none, inline="nwc2",
    tooltip="Bold the High and Low labels. The 50% and quarter labels have their own Bold on the Mid Line and Quarters rows.")
bool   nwc_mid  = input.bool(true, "Mid Line ▸", group=GNW, display=display.none, inline="nwc3")
string nwc_msty = input.string("Dotted", "", options=["Solid","Dashed","Dotted"], group=GNW, display=display.none, inline="nwc3")
int    nwc_mw   = input.int(1, "", minval=1, maxval=10, group=GNW, display=display.none, inline="nwc3")
bool   nwc_mbold = input.bool(false, "Bold", group=GNW, display=display.none, inline="nwc3")
bool   nwc_mlbl = input.bool(true, "Label", group=GNW, display=display.none, inline="nwc3",
    tooltip="Show the 50% label. Off draws the mid line without any text.")
bool   nwc_qtr  = input.bool(false, "Quarters ▸", group=GNW, display=display.none, inline="nwc4")
string nwc_qsty = input.string("Dotted", "", options=["Solid","Dashed","Dotted"], group=GNW, display=display.none, inline="nwc4")
int    nwc_qw   = input.int(1, "", minval=1, maxval=10, group=GNW, display=display.none, inline="nwc4")
bool   nwc_qbold = input.bool(false, "Bold", group=GNW, display=display.none, inline="nwc4")
bool   nwc_qlbl = input.bool(true, "Label", group=GNW, display=display.none, inline="nwc4",
    tooltip="Show the 25% and 75% labels. Off draws the quarter lines without any text.")

bool   nwp_on   = input.bool(true, "Previous ▸", group=GNW, display=display.none, inline="nwp0")
int    nwp_keep = input.int(5, "Show Last:", minval=1, maxval=10, group=GNW, display=display.none, inline="nwp0",
    tooltip="How many NWOG gaps before the current one to draw, each in the Previous styling below. The current gap is controlled by its own checkbox above.")
color  nwp_lcol = input.color(#8A8D97, "Line ▸", group=GNW, display=display.none, inline="nwp1")
string nwp_lsty = input.string("Solid", "", options=["Solid","Dashed","Dotted"], group=GNW, display=display.none, inline="nwp1")
int    nwp_lw   = input.int(1, "", minval=1, maxval=10, group=GNW, display=display.none, inline="nwp1")
color  nwp_tcol = input.color(#8A8D97, "Text ▸", group=GNW, display=display.none, inline="nwp2")
string nwp_tsz  = input.string("Small", "", options=["Tiny","Small","Normal","Large"], group=GNW, display=display.none, inline="nwp2")
string nwp_tpos = input.string("Middle", "", options=["Top","Middle","Bottom"], group=GNW, display=display.none, inline="nwp2")
bool   nwp_date = input.bool(true, "Date", group=GNW, display=display.none, inline="nwp2",
    tooltip="Append the date of the gap's open to every label of these gaps, as MM/DD — e.g. 'NWOG High 09/13'.")
bool   nwp_bold = input.bool(true, "Bold", group=GNW, display=display.none, inline="nwp2",
    tooltip="Bold the High and Low labels. The 50% and quarter labels have their own Bold on the Mid Line and Quarters rows.")
bool   nwp_mid  = input.bool(true, "Mid Line ▸", group=GNW, display=display.none, inline="nwp3")
string nwp_msty = input.string("Dotted", "", options=["Solid","Dashed","Dotted"], group=GNW, display=display.none, inline="nwp3")
int    nwp_mw   = input.int(1, "", minval=1, maxval=10, group=GNW, display=display.none, inline="nwp3")
bool   nwp_mbold = input.bool(false, "Bold", group=GNW, display=display.none, inline="nwp3")
bool   nwp_mlbl = input.bool(true, "Label", group=GNW, display=display.none, inline="nwp3",
    tooltip="Show the 50% label. Off draws the mid line without any text.")
bool   nwp_qtr  = input.bool(false, "Quarters ▸", group=GNW, display=display.none, inline="nwp4")
string nwp_qsty = input.string("Dotted", "", options=["Solid","Dashed","Dotted"], group=GNW, display=display.none, inline="nwp4")
int    nwp_qw   = input.int(1, "", minval=1, maxval=10, group=GNW, display=display.none, inline="nwp4")
bool   nwp_qbold = input.bool(false, "Bold", group=GNW, display=display.none, inline="nwp4")
bool   nwp_qlbl = input.bool(false, "Label", group=GNW, display=display.none, inline="nwp4",
    tooltip="Show the 25% and 75% labels. Off draws the quarter lines without any text.")

// ===========================================================================
// INPUTS - NDOG
// ===========================================================================
string GND = "『 NDOG 』"
bool   ndc_on   = input.bool(true, "Current ▸", group=GND, display=display.none, inline="ndc0", tooltip="New Day Opening Gap: the 16:59 close to the 18:00 open, Monday through Thursday (New York time). Quarter and mid levels are measured from the open toward the prior close.")
color  ndc_lcol = input.color(#2962FF, "Line ▸", group=GND, display=display.none, inline="ndc1")
