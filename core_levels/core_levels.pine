string l_take  = input.string("Keep", "When Taken", options=["Keep","Stop at take","Remove"], group=GL, display=display.none, tooltip=TAKE_TIP)

string GN = "Midnight Open"
bool   mn_on   = input.bool(true, "Midnight Open", group=GN, display=display.none,
    tooltip="The open of today's 00:00 New York candle. The line starts on that candle and always runs to its label. Shown on 1-hour and lower charts.")
color  mn_lcol = input.color(#000000, "Line", group=GN, display=display.none, inline="mn1")
string mn_lsty = input.string("Dashed", "", options=["Solid","Dashed","Dotted"], group=GN, display=display.none, inline="mn1")
