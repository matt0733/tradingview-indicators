bool   nd_mid  = input.bool(true, "Mid Line", group=GND, display=display.none, inline="nd3")
string nd_msty = input.string("Dotted", "", options=["Solid","Dashed","Dotted"], group=GND, display=display.none, inline="nd3")
int    nd_mw   = input.int(2, "", minval=1, maxval=10, group=GND, display=display.none, inline="nd3")
bool   nd_mb   = input.bool(true, "Bold", group=GND, display=display.none, inline="nd3")
bool   nd_mlbl = input.bool(true, "Label", group=GND, display=display.none, inline="nd3",
    tooltip="Show the 50% label. Off draws the mid line without any text.")
bool   nd_qtr  = input.bool(true, "Quarters", group=GND, display=display.none, inline="nd4")
string nd_qsty = input.string("Dotted", "", options=["Solid","Dashed","Dotted"], group=GND, display=display.none, inline="nd4")
int    nd_qw   = input.int(2, "", minval=1, maxval=10, group=GND, display=display.none, inline="nd4")
bool   nd_qb   = input.bool(true, "Bold", group=GND, display=display.none, inline="nd4")
bool   nd_qlbl = input.bool(true, "Label", group=GND, display=display.none, inline="nd4",
    tooltip="Show the 25% and 75% labels. Off draws the quarter lines without any text.")

// ===========================================================================
// TYPES
// ===========================================================================
// Kinds, longest period first (ties in the label column put the longer one on top):
// 0 month, 1 week, 2 day, 3 day close, 4 Asia, 5 London, 6 midnight, 7 premarket,
// 8 RTH gap high/low, 9 RTH 50%, 10 RTH 25%/75%, 11-13 the same for the NWOG,
// 14-16 for the NDOG
type Cfg
    color  lcol
    string lsty
    int    lw
    color  tcol
    string tsz
    bool   bold
    color  lcol2   // low side (highs/lows kinds only)
    string lsty2
    int    lw2
    color  tcol2
    string tsz2
    bool   bold2
    string take    // "Keep", "Stop at take", "Remove"; na for levels without takes

type Level
    int    kind
    bool   is_hi
    float  price
    int    t1             // open time of the candle the line starts on
    int    take_t         // open time of the candle that took it, na while untaken
    bool   live = false   // still forming (premarket before 09:00): not takeable yet
    string name           // label text before the price; "" draws the line without a label

// Running high/low of a period or session, measured on chart bars
type Tracker
    float h
    float l
    int   ht
    int   lt
    bool  full = false    // started at a real rollover, so it saw the whole period

// ===========================================================================
// HELPERS
// ===========================================================================
const string TZ        = "America/New_York"
const int    LEAD_BARS = 3   // length of a leader to a moved label
float tol = syminfo.mintick / 2

ls(s) =>
    switch s
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        =>          line.style_solid

lbl_sz(s) =>
    switch s
        "Tiny"   => size.tiny
        "Normal" => size.normal
        "Large"  => size.large
        =>          size.small

// Price as TradingView shows it, including CBOT fractional prices (ZB 106'03)
pad(int n, int w) =>
    string r = str.tostring(n)
    while str.length(r) < w
        r := "0" + r
    r

fmt_px(float p) =>
    int ps = syminfo.pricescale
    if not array.from(4, 8, 16, 32, 64, 128, 256).includes(ps)
        str.tostring(p, format.mintick)
    else
        float a = math.abs(p)
        int   h = int(math.floor(a + 1e-9))
        float f = a - h
        string fr = ""
        if ps <= 32
            fr := pad(int(math.round(f * ps)), str.length(str.tostring(ps - 1)))
        else
            float t = f * 32
            int   n = int(math.floor(t + 1e-9))
            fr := pad(n, 2) + "'" + str.tostring(int(math.floor((t - n) * 10 + 1e-9)))
        (p < 0 ? "-" : "") + str.tostring(h) + "'" + fr

// A period level is drawn when its period is at least as long as the chart's bars
tf_vis(string tf) =>
    timeframe.in_seconds() <= timeframe.in_seconds(tf)

// Session levels need bars that line up with the session times
bool intra_ok = (timeframe.isminutes or timeframe.isseconds) and timeframe.in_seconds() <= 3600
// NWOG/NDOG: intraday bars break at the 17:00 halt and restart at 18:00, so up to
// 4 hours the last bar before the halt closes on the 16:59 trade
bool gap_ok   = (timeframe.isminutes or timeframe.isseconds) and timeframe.in_seconds() <= 14400

const int SEARCH_BARS = 4999   // how far back a search looks for a candle; max_bars_back allows 5000
max_bars_back(time, SEARCH_BARS + 1)
max_bars_back(high, SEARCH_BARS + 1)
max_bars_back(low, SEARCH_BARS + 1)

// Open time of the latest chart bar at or before t: a lower-timeframe time (09:30
// on a 1h chart) would otherwise draw on the next bar
snap_t(int t) =>
    int r = t
    for i = 0 to SEARCH_BARS
        if na(time[i])
            break
        if time[i] <= t
            r := time[i]
            break
    r

// Latest chart bar at or before t_end, within the day before it, that traded p.
// Settlement is an average over its window, so it can sit off the last candle;
// the bar holding t_end when no bar in reach did.
touch_t(float p, int t_end) =>
    int r = na
    for i = 0 to SEARCH_BARS
        if na(time[i]) or time[i] < t_end - 86400000
            break
        if time[i] <= t_end and low[i] - tol <= p and p <= high[i] + tol
            r := time[i]
            break
    na(r) ? snap_t(t_end) : r

trk_reset(Tracker tr) =>
    tr.h  := high
    tr.l  := low
    tr.ht := time
    tr.lt := time

// Strictly higher/lower, so ties keep the earliest candle
trk_update(Tracker tr) =>
    if na(tr.h)
        trk_reset(tr)
    else
        if high > tr.h
            tr.h  := high
            tr.ht := time
        if low < tr.l
            tr.l  := low
            tr.lt := time
    true

// RTH session for the opening range gap
auto_market(string r) =>
    if array.from("ZT", "ZF", "ZN", "TN", "ZB", "TWE", "UB").includes(r)
        "Treasuries"
    else if array.from("CL", "MCL", "QM").includes(r)
        "Crude Oil"
    else if array.from("NG", "MNG", "QG").includes(r)
        "Natural Gas"
    else if array.from("GC", "MGC", "QO", "1OZ").includes(r)
        "Gold"
    else if array.from("SI", "SIL", "QI", "SIC").includes(r)
        "Silver"
    else if array.from("HG", "MHG", "QC").includes(r)
        "Copper"
    else
        "Equity Index"

// Seconds since midnight of an "HHMM" time
hhmm_sec(string s) =>
    int(str.tonumber(str.substring(s, 0, 2))) * 3600 + int(str.tonumber(str.substring(s, 2, 4))) * 60

string RT_MKT = rt_mkt == "Auto" ? auto_market(syminfo.root) : rt_mkt
// CME's floor hours, New York time; each close is where the settlement window ends
string RT_HRS = switch RT_MKT
    "Treasuries"  => "0820-1500"
    "Crude Oil"   => "0900-1430"
    "Natural Gas" => "0900-1430"
    "Gold"        => "0820-1330"
    "Silver"      => "0825-1325"
    "Copper"      => "0810-1300"
    "Custom"      => rt_hrs
    =>               "0930-1615"
int  S_RTH_OPEN  = hhmm_sec(str.substring(RT_HRS, 0, 4))
int  S_RTH_CLOSE = hhmm_sec(str.substring(RT_HRS, 5, 9))
// 1OZ and SIC trade around the clock; their daily close is the 17:00 trade
bool RT_SETTLE   = (rt_px == "Settlement" or (rt_px == "Auto" and RT_MKT != "Equity Index" and RT_MKT != "Custom"))
     and not array.from("1OZ", "SIC").includes(syminfo.root)

ymd(int t, string tz) =>
    year(t, tz) * 10000 + month(t, tz) * 100 + dayofmonth(t, tz)

f_mmdd(int t) =>
    int m = month(t, TZ)
    int d = dayofmonth(t, TZ)
    (m < 10 ? "0" : "") + str.tostring(m) + "/" + (d < 10 ? "0" : "") + str.tostring(d)

lbl_sty(string pos) =>
    switch pos
        "Top"    => label.style_label_lower_left
        "Bottom" => label.style_label_upper_left
        =>          label.style_label_left

// Run on bars that land on the session open and close: the latest gap as
// [prior close, its bar time, open, its bar time]. A session opens on the bar
// holding the open time (or a thin contract's first bar after it), once a day,
// Monday to Friday. CME folds a holiday's Globex trading into the next trading
// date, so a holiday morning's bars carry the next day's date: that day is not a
// real session and its trades are ignored.
rth_state() =>
    var float day_close   = na    // running last trade before the close today
    var int   day_close_t = na
    var bool  day_real    = false
    var float rth_close   = na    // last trade before the close of the last real session
    var int   rth_close_t = na
    var int   rth_day     = 0
    var float g_pc        = na
    var int   g_pc_t      = na
    var float g_op        = na
    var int   g_op_t      = na
    int  sod     = hour(time, TZ) * 3600 + minute(time, TZ) * 60 + second(time, TZ)
    int  dow     = dayofweek(time, TZ)
    int  tfs     = timeframe.in_seconds()
    bool weekday = dow >= dayofweek.monday and dow <= dayofweek.friday
    bool holds   = sod <= S_RTH_OPEN and S_RTH_OPEN < sod + tfs
    bool after   = sod > S_RTH_OPEN and sod < S_RTH_CLOSE
    if weekday and (holds or after) and ymd(time, TZ) != rth_day
        rth_day := ymd(time, TZ)
        if day_real
            rth_close   := day_close
            rth_close_t := day_close_t
        day_real := ymd(time_tradingday, "UTC") == ymd(time, TZ)
        if day_real and not na(rth_close)
            g_pc   := rth_close
            g_pc_t := rth_close_t
            g_op   := open
            g_op_t := time
    if day_real and weekday and sod >= S_RTH_OPEN and sod < S_RTH_CLOSE
        day_close   := close
        day_close_t := time
    [g_pc, g_pc_t, g_op, g_op_t]

gcd(int a, int b) =>
    int x = a
    int y = b
    while y != 0
        int t = x % y
        x := y
        y := t
    x

// The chart's own bars when they land on the open and close (1, 3, 5, 15m for
// Equity Index); otherwise the largest bar size, no larger than the chart's own
// (and at most 30m), that does
int    rth_step = gcd(S_RTH_OPEN, S_RTH_CLOSE)
string rt_tf    = rth_step % timeframe.in_seconds() == 0 ? timeframe.period : "1"
if rt_tf == "1" and timeframe.in_seconds() >= 60
    for m in array.from(30, 15, 10, 5, 3, 2)
        if m * 60 <= timeframe.in_seconds() and rth_step % (m * 60) == 0
            rt_tf := str.tostring(m)
            break

// ===========================================================================
// STATE
// ===========================================================================
// One slot per line on the chart
const int S_MH = 0
const int S_ML = 1
const int S_WH = 2
const int S_WL = 3
const int S_DH = 4
const int S_DL = 5
const int S_PC = 6
const int S_AH = 7
const int S_AL = 8
const int S_LH = 9
const int S_LL = 10
const int S_MN = 11
const int S_PH = 12
const int S_PL = 13
const int S_RH = 14
const int S_RL = 15
const int S_R50 = 16
const int S_R25 = 17
const int S_R75 = 18
const int S_NW  = 19   // NWOG: high, low, 50%, 25%, 75% in slots 19-23
const int S_ND  = 24   // NDOG: slots 24-28

var array<Level> lv = array.new<Level>(29)

// One gap's five levels in slots s..s+4, kinds k..k+2 (edges, 50%, quarters).
// High and Low start where each price was set; 50% and quarters from the open,
// measured toward the prior close. A gap of zero clears the slots.
set_gap(int s, int k, string nm, float pc, int pc_t, float op, int op_t, bool date, bool mlbl, bool qlbl) =>
    for i = s to s + 4
        lv.set(i, na)
    if pc != op
        string dt  = date ? " " + f_mmdd(op_t) : ""
        bool   dn  = pc >= op   // gap down: the prior close is the high
        float  spn = pc - op
        lv.set(s,     Level.new(k,     true,  math.max(pc, op), dn ? pc_t : op_t, na, false, nm + " High" + dt))
        lv.set(s + 1, Level.new(k,     false, math.min(pc, op), dn ? op_t : pc_t, na, false, nm + " Low" + dt))
        lv.set(s + 2, Level.new(k + 1, true,  op + spn * 0.5,   op_t, na, false, mlbl ? nm + " 50%" + dt : ""))
        lv.set(s + 3, Level.new(k + 2, true,  op + spn * 0.25,  op_t, na, false, qlbl ? nm + " 25%" + dt : ""))
        lv.set(s + 4, Level.new(k + 2, true,  op + spn * 0.75,  op_t, na, false, qlbl ? nm + " 75%" + dt : ""))
    true
var int first_t = time

var Tracker m_tr = Tracker.new()
var Tracker w_tr = Tracker.new()
var Tracker d_tr = Tracker.new()
var Tracker a_tr = Tracker.new()
var Tracker l_tr = Tracker.new()
var Tracker p_tr = Tracker.new()

// At a rollover, the completed period's high and low. The price comes from the
// higher-timeframe candle (hp/lp, from the bar before, so it never looks ahead);
// the start candle from the chart's own bars. When the chart began partway through
// the period and its bars never reached that price, the line starts on the chart's
// first bar. Called only on a rollover bar, before the tracker is reset.
period_hl(Tracker tr, float hp, float lp, int kind, string nm) =>
    float ph = na(hp) ? tr.h : hp
    float pl = na(lp) ? tr.l : lp
    int   th = (tr.full or tr.h >= ph - tol) ? tr.ht : first_t
    int   tl = (tr.full or tr.l <= pl + tol) ? tr.lt : first_t
    [Level.new(kind, true, ph, th, na, false, nm + " High"), Level.new(kind, false, pl, tl, na, false, nm + " Low")]

// Session in progress: track it. Session just ended: its high and low replace the
// previous session's.
roll_session(Tracker tr, bool inn, bool was, int kind, int ih, int il, string nm) =>
    if inn
        if not was
            trk_reset(tr)
        else
            trk_update(tr)
    else if was and not na(tr.h)
        lv.set(ih, Level.new(kind, true,  tr.h, tr.ht, na, false, nm + " High"))
        lv.set(il, Level.new(kind, false, tr.l, tr.lt, na, false, nm + " Low"))
    true

// ===========================================================================
// LEVELS
// ===========================================================================
// Previous completed candle's values; read only on a rollover bar
[m_hp, m_lp]       = request.security(syminfo.tickerid, "M", [high[1], low[1]], lookahead=barmerge.lookahead_on)
[w_hp, w_lp]       = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead=barmerge.lookahead_on)
[d_hp, d_lp, d_cp] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], lookahead=barmerge.lookahead_on)

bool new_m = timeframe.change("M")
bool new_w = timeframe.change("W")
bool new_d = timeframe.change("D")

if new_m and not na(m_tr.h)
    [hi, lo] = period_hl(m_tr, m_hp, m_lp, 0, "Previous Monthly")
    lv.set(S_MH, hi)
    lv.set(S_ML, lo)
if new_w and not na(w_tr.h)
    [hi, lo] = period_hl(w_tr, w_hp, w_lp, 1, "Previous Weekly")
    lv.set(S_WH, hi)
    lv.set(S_WL, lo)
if new_d and not na(d_tr.h)
    [hi, lo] = period_hl(d_tr, d_hp, d_lp, 2, "Previous Day")
    lv.set(S_DH, hi)
    lv.set(S_DL, lo)
// Then start tracking the new period, or keep tracking the current one
if new_m
    m_tr.full := not na(m_tr.h)
    trk_reset(m_tr)
else
    trk_update(m_tr)
if new_w
    w_tr.full := not na(w_tr.h)
    trk_reset(w_tr)
else
    trk_update(w_tr)
if new_d
    d_tr.full := not na(d_tr.h)
    trk_reset(d_tr)
else
    trk_update(d_tr)

// Previous day close, starting on that day's last candle (for a settlement price
// that candle didn't trade, the latest one before it that did)
if new_d and bar_index > 0
    float pc = cl_md == "Settlement" and not na(d_cp) ? d_cp : close[1]
    int   pt = cl_md == "Settlement" and pc != close[1] ? touch_t(pc, time[1]) : time[1]
    lv.set(S_PC, Level.new(3, true, pc, pt, na, false, "Previous Day Close"))

// Sessions (New York time)
bool a_in = not na(time(timeframe.period, a_sess, TZ))
bool l_in = not na(time(timeframe.period, l_sess, TZ))
bool p_in = not na(time(timeframe.period, "0700-0900", TZ))
roll_session(a_tr, a_in, a_in[1], 4, S_AH, S_AL, "Asia")
roll_session(l_tr, l_in, l_in[1], 5, S_LH, S_LL, "London")

// Midnight Open: the first candle of the New York day, if it opens in the 00:00 hour
// (the Sunday 18:00 futures open also starts a new date, so the hour is checked)
if dayofmonth(time, TZ) != dayofmonth(time[1], TZ) and hour(time, TZ) == 0
    lv.set(S_MN, Level.new(6, true, open, time, na, false, "Midnight Open"))

// Premarket: forms live from 07:00, locks at 09:00, replaced at the next 07:00
if p_in
    if not p_in[1]
        trk_reset(p_tr)
    else
        trk_update(p_tr)
    lv.set(S_PH, Level.new(7, true,  p_tr.h, p_tr.ht, na, true, "Premarket High"))
    lv.set(S_PL, Level.new(7, false, p_tr.l, p_tr.lt, na, true, "Premarket Low"))
else if p_in[1]
    for s in array.from(S_PH, S_PL)
        Level x = lv.get(s)
        if not na(x)
            x.live := false

// RTH opening range gap: read when the chart bar holding the open arrives. With
// lookahead off, a lower timeframe returns its latest bar inside the chart bar.
[g_pc, g_pc_t, g_op, g_op_t] = request.security(syminfo.tickerid, rt_tf, rth_state(), lookahead=barmerge.lookahead_off)
if intra_ok and not na(g_op_t) and g_op_t != nz(g_op_t[1])
    float p  = g_pc
    int   pt = snap_t(g_pc_t)
    if RT_SETTLE and not na(d_cp) and d_cp != g_pc
        p  := d_cp
        pt := touch_t(d_cp, g_pc_t)
    set_gap(S_RH, 8, "RTH", p, pt, g_op, snap_t(g_op_t), rt_date, rt_mlbl, rt_qlbl)

// NWOG / NDOG: the last trade before the 17:00 halt to the 18:00 reopen, from the
// chart's own bars. Sunday's reopen is the NWOG, Monday to Thursday the NDOG.
const int S_HALT   = 17 * 3600
const int S_REOPEN = 18 * 3600
var float eve_close   = na    // close of the latest bar starting before 17:00
var int   eve_close_t = na
if gap_ok
    int sod = hour(time, TZ) * 3600 + minute(time, TZ) * 60 + second(time, TZ)
    int dow = dayofweek(time, TZ)
    if sod <= S_REOPEN and S_REOPEN < sod + timeframe.in_seconds() and not na(eve_close)
        if dow == dayofweek.sunday
            set_gap(S_NW, 11, "NWOG", eve_close, eve_close_t, open, time, nw_date, nw_mlbl, nw_qlbl)
        else if dow >= dayofweek.monday and dow <= dayofweek.thursday
            set_gap(S_ND, 14, "NDOG", eve_close, eve_close_t, open, time, nd_date, nd_mlbl, nd_qlbl)
    if sod < S_HALT
        eve_close   := close
        eve_close_t := time

// Takes: a wick through the level on any candle after it was set. Closes, opens
// and the gaps have no takes.
for x in lv
    if not na(x)
        if x.kind != 3 and x.kind != 6 and x.kind < 8 and not x.live and na(x.take_t)
            if x.is_hi ? high >= x.price : low <= x.price
                x.take_t := time

// ===========================================================================
// DRAWING
// ===========================================================================
// High and low of the bars in view; the script recalculates when the view changes
var float vis_hi = na
var float vis_lo = na
if time >= chart.left_visible_bar_time and time <= chart.right_visible_bar_time
    vis_hi := na(vis_hi) ? high : math.max(vis_hi, high)
    vis_lo := na(vis_lo) ? low  : math.min(vis_lo, low)

// Built on every bar: settings captured once never pass on changed colors
cfg_of(int kind) =>
    switch kind
        0 => Cfg.new(m_lcol, m_lsty, m_lw, m_tcol, m_tsz, m_tb, m_lcol2, m_lsty2, m_lw2, m_tcol2, m_tsz2, m_tb2, m_take)
        1 => Cfg.new(w_lcol, w_lsty, w_lw, w_tcol, w_tsz, w_tb, w_lcol2, w_lsty2, w_lw2, w_tcol2, w_tsz2, w_tb2, w_take)
        2 => Cfg.new(d_lcol, d_lsty, d_lw, d_tcol, d_tsz, d_tb, d_lcol2, d_lsty2, d_lw2, d_tcol2, d_tsz2, d_tb2, d_take)
        3 => Cfg.new(pc_lcol, pc_lsty, pc_lw, pc_tcol, pc_tsz, pc_tb, pc_lcol, pc_lsty, pc_lw, pc_tcol, pc_tsz, pc_tb, "Keep")
        4 => Cfg.new(a_lcol, a_lsty, a_lw, a_tcol, a_tsz, a_tb, a_lcol2, a_lsty2, a_lw2, a_tcol2, a_tsz2, a_tb2, a_take)
        5 => Cfg.new(l_lcol, l_lsty, l_lw, l_tcol, l_tsz, l_tb, l_lcol2, l_lsty2, l_lw2, l_tcol2, l_tsz2, l_tb2, l_take)
        6 => Cfg.new(mn_lcol, mn_lsty, mn_lw, mn_tcol, mn_tsz, mn_tb, mn_lcol, mn_lsty, mn_lw, mn_tcol, mn_tsz, mn_tb, "Keep")
        8 => Cfg.new(rt_lcol, rt_lsty, rt_lw, rt_tcol, rt_tsz, rt_tb, rt_lcol, rt_lsty, rt_lw, rt_tcol, rt_tsz, rt_tb, "Keep")
        9 => Cfg.new(rt_lcol, rt_msty, rt_mw, rt_tcol, rt_tsz, rt_mb, rt_lcol, rt_msty, rt_mw, rt_tcol, rt_tsz, rt_mb, "Keep")
        10 => Cfg.new(rt_lcol, rt_qsty, rt_qw, rt_tcol, rt_tsz, rt_qb, rt_lcol, rt_qsty, rt_qw, rt_tcol, rt_tsz, rt_qb, "Keep")
        11 => Cfg.new(nw_lcol, nw_lsty, nw_lw, nw_tcol, nw_tsz, nw_tb, nw_lcol, nw_lsty, nw_lw, nw_tcol, nw_tsz, nw_tb, "Keep")
        12 => Cfg.new(nw_lcol, nw_msty, nw_mw, nw_tcol, nw_tsz, nw_mb, nw_lcol, nw_msty, nw_mw, nw_tcol, nw_tsz, nw_mb, "Keep")
        13 => Cfg.new(nw_lcol, nw_qsty, nw_qw, nw_tcol, nw_tsz, nw_qb, nw_lcol, nw_qsty, nw_qw, nw_tcol, nw_tsz, nw_qb, "Keep")
        14 => Cfg.new(nd_lcol, nd_lsty, nd_lw, nd_tcol, nd_tsz, nd_tb, nd_lcol, nd_lsty, nd_lw, nd_tcol, nd_tsz, nd_tb, "Keep")
        15 => Cfg.new(nd_lcol, nd_msty, nd_mw, nd_tcol, nd_tsz, nd_mb, nd_lcol, nd_msty, nd_mw, nd_tcol, nd_tsz, nd_mb, "Keep")
        16 => Cfg.new(nd_lcol, nd_qsty, nd_qw, nd_tcol, nd_tsz, nd_qb, nd_lcol, nd_qsty, nd_qw, nd_tcol, nd_tsz, nd_qb, "Keep")
        =>   Cfg.new(pm_lcol, pm_lsty, pm_lw, pm_tcol, pm_tsz, pm_tb, pm_lcol2, pm_lsty2, pm_lw2, pm_tcol2, pm_tsz2, pm_tb2, pm_take)

kind_on(int kind) =>
    switch kind
        0 => m_on and tf_vis("M")
        1 => w_on and tf_vis("W")
        2 => d_on and tf_vis("D")
        3 => pc_on and tf_vis("D")
        4 => a_on and intra_ok
        5 => l_on and intra_ok
        6 => mn_on and intra_ok
        7 => pm_on and intra_ok
        8 => rt_on and intra_ok
        9 => rt_on and rt_mid and intra_ok
        10 => rt_on and rt_qtr and intra_ok
        11 => nw_on and gap_ok
        12 => nw_on and nw_mid and gap_ok
        13 => nw_on and nw_qtr and gap_ok
        14 => nd_on and gap_ok
        15 => nd_on and nd_mid and gap_ok
        =>   nd_on and nd_qtr and gap_ok

// Label position of a gap's labels
gap_tpos(int kind) =>
    kind >= 14 ? nd_tpos : kind >= 11 ? nw_tpos : rt_tpos

var array<line>  lns = array.new<line>()
var array<label> lbs = array.new<label>()

if barstate.islast
    for ln in lns
        ln.delete()
    for lb in lbs
        lb.delete()
    lns.clear()
    lbs.clear()

    // Past the current bar, positions are counted in bars: a time offset would
    // collapse into the next session open whenever it lands in a market break. Up to
    // the current bar lines are time-based, so a level can start any distance back.
    int x_lbl = bar_index + lbl_off
    int x_ldr = bar_index + math.max(lbl_off - LEAD_BARS, 0)   // where a leader starts
    array<label>  col    = array.new<label>()   // labels sitting at x_lbl
    array<line>   col_ln = array.new<line>()
    array<float>  col_y  = array.new<float>()
    array<float>  col_k  = array.new<float>()
    array<color>  col_c  = array.new<color>()
    array<string> col_s  = array.new<string>()
    array<int>    col_w  = array.new<int>()
    for a in lv
        if not na(a) and not na(a.price) and kind_on(a.kind)
            Cfg  c    = cfg_of(a.kind)
            bool tkn  = not na(a.take_t)
            if not (tkn and c.take == "Remove")
                bool   lo   = not a.is_hi and a.kind < 8   // gap lows use the gap's one style
                color  lcol = lo ? c.lcol2 : c.lcol
                color  tcol = lo ? c.tcol2 : c.tcol
                string lsty = lo ? c.lsty2 : c.lsty
                int    lw   = lo ? c.lw2 : c.lw
                bool   bold = lo ? c.bold2 : c.bold
                string tsz  = lo ? c.tsz2 : c.tsz
                bool   stop = tkn and c.take == "Stop at take"
                string txt  = a.name == "" ? "" : a.name + (show_px ? " (" + fmt_px(a.price) + ")" : "")
                int    x2   = stop ? a.take_t : time
                lns.push(line.new(a.t1, a.price, x2, a.price, xloc=xloc.bar_time,
                                  color=lcol, style=ls(lsty), width=lw))
                if stop
                    lbs.push(label.new(int((a.t1 + x2) / 2), a.price, txt, xloc=xloc.bar_time,
                                       style=a.is_hi ? label.style_label_down : label.style_label_up,
                                       color=color.new(color.white, 100), textcolor=tcol,
                                       size=lbl_sz(tsz), textalign=text.align_left,
                                       text_formatting=bold ? text.format_bold : text.format_none))
                else
                    line  fut = line.new(bar_index, a.price, x_lbl, a.price, xloc=xloc.bar_index,
                                         color=lcol, style=ls(lsty), width=lw)
                    lns.push(fut)
                if not stop and txt != ""
                    line  fut = lns.last()
                    label lb  = label.new(x_lbl, a.price, txt, xloc=xloc.bar_index, style=a.kind >= 8 ? lbl_sty(gap_tpos(a.kind)) : label.style_label_left,
                                          color=color.new(color.white, 100), textcolor=tcol,
                                          size=lbl_sz(tsz), textalign=text.align_left,
                                          text_formatting=bold ? text.format_bold : text.format_none)
                    lbs.push(lb)
                    col.push(lb)
                    col_ln.push(fut)
                    col_y.push(a.price)
                    col_k.push(a.price - a.kind * tol / 40)   // ties: longer period on top
                    col_c.push(lcol)
                    col_s.push(lsty)
                    col_w.push(lw)

    // Labels closer than one label height (thr) are spaced out evenly around their
    // prices, highest at the top, each joined to its line by a short leader. Works
    // top-down in blocks: a label that overlaps the block above joins it, and the
    // block is re-centred on its members' prices (which can make it overlap the
    // next block up, so merging repeats).
    float thr = math.max(nz(vis_hi - vis_lo) * lbl_gap / 100, tol)
    int   n   = col.size()
    int n_vis = 0
    for y in col_y
        if y >= vis_lo and y <= vis_hi
            n_vis += 1
    bool crowded = crowd_off and n_vis * thr > nz(vis_hi - vis_lo)
    if n > 1 and spread_on and not crowded
        array<int>   ord   = col_k.sort_indices(order.descending)
        array<float> b_top = array.new<float>()   // y of each block's first label
        array<float> b_sum = array.new<float>()   // sum of its members' prices
        array<int>   b_len = array.new<int>()
        for i = 0 to n - 1
            float p = col_y.get(ord.get(i))
            b_top.push(p)
            b_sum.push(p)
            b_len.push(1)
            while b_top.size() > 1
                int   m     = b_top.size()
                float above = b_top.get(m - 2) - (b_len.get(m - 2) - 1) * thr   // lowest y of block above
                if b_top.get(m - 1) > above - thr
                    float sum = b_sum.get(m - 2) + b_sum.get(m - 1)
                    int   len = b_len.get(m - 2) + b_len.get(m - 1)
                    b_top.pop()
                    b_sum.pop()
                    b_len.pop()
                    b_top.set(m - 2, sum / len + (len - 1) * thr / 2)
                    b_sum.set(m - 2, sum)
                    b_len.set(m - 2, len)
                else
                    break
        int k = 0
        for b = 0 to b_top.size() - 1
            for r = 0 to b_len.get(b) - 1
                int   idx = ord.get(k)
                float y   = b_top.get(b) - r * thr
                float p   = col_y.get(idx)
                bool too_far = max_move > 0 and math.abs(y - p) > max_move * thr + tol
                if math.abs(y - p) > thr / 100 and not too_far
                    col_ln.get(idx).set_x2(x_ldr)
                    col.get(idx).set_y(y)
                    lns.push(line.new(x_ldr, p, x_lbl, y, xloc=xloc.bar_index,
                                      color=col_c.get(idx), style=ls(col_s.get(idx)), width=col_w.get(idx)))
                k += 1
