string GP = "Premarket"
bool   pm_on   = input.bool(true, "Premarket High / Low", group=GP, display=display.none,
    tooltip="The high and low between 07:00 and 09:00 New York. They appear at 07:00 and follow new highs and lows until 09:00, then hold until the next day's 07:00. Lines start on the candle that set each price. Shown on 1-hour and lower charts.")
color  pm_lcol = input.color(#F23645, "High Line", group=GP, display=display.none, inline="pm1")
string pm_lsty = input.string("Solid", "", options=["Solid","Dashed","Dotted"], group=GP, display=display.none, inline="pm1")
int    pm_lw   = input.int(1, "", minval=1, maxval=10, group=GP, display=display.none, inline="pm1")
color  pm_tcol = input.color(#F23645, "High Text", group=GP, display=display.none, inline="pm2")
string pm_tsz  = input.string("Small", "", options=["Tiny","Small","Normal","Large"], group=GP, display=display.none, inline="pm2")
