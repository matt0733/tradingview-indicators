string pm_tsz2  = input.string("Small", "", options=["Tiny","Small","Normal","Large"], group=GP, display=display.none, inline="pm4")
bool   pm_tb2   = input.bool(true, "Bold", group=GP, display=display.none, inline="pm4")
string pm_take = input.string("Keep", "When Taken", options=["Keep","Stop at take","Remove"], group=GP, display=display.none,
    tooltip="What happens once price trades through the premarket high or low after 09:00 (a wick touch counts). Keep: the line runs on to its label. Stop at take: the line ends at the candle that took it and the label moves to the middle of the line - above it for the high, below it for the low. Remove: the line and label are deleted.")

// ===========================================================================
// INPUTS - RTH ORG
// ===========================================================================
string GR = "RTH ORG"
bool   rt_on   = input.bool(true, "RTH Opening Range Gap", group=GR, display=display.none,
    tooltip="The regular session's close to the next regular open, Monday through Friday (New York time) - for Equity Index the 16:14 close to the next 09:30 open. The session and the close price are set by Market and Close Price below. The gap appears at the open and stays until the next session opens; it has no takes. Quarter and mid levels are measured from the open toward the prior close, so 25% means the gap is a quarter filled. Futures holidays are skipped, so the next gap runs from the last real session's close. Shown on 1-hour and lower charts; where the chart's bars don't land on the open and close, the prices come from a lower timeframe that does.")
color  rt_lcol = input.color(#F23645, "Line", group=GR, display=display.none, inline="rt1")
string rt_lsty = input.string("Solid", "", options=["Solid","Dashed","Dotted"], group=GR, display=display.none, inline="rt1")
int    rt_lw   = input.int(2, "", minval=1, maxval=10, group=GR, display=display.none, inline="rt1")
color  rt_tcol = input.color(#F23645, "Text", group=GR, display=display.none, inline="rt2")
string rt_tsz  = input.string("Small", "", options=["Tiny","Small","Normal","Large"], group=GR, display=display.none, inline="rt2")
string rt_tpos = input.string("Middle", "", options=["Top","Middle","Bottom"], group=GR, display=display.none, inline="rt2")
bool   rt_date = input.bool(true, "Date", group=GR, display=display.none, inline="rt2",
    tooltip="Append the date of the gap's open to every label, as MM/DD - e.g. 'RTH High 11/06'.")
bool   rt_tb   = input.bool(true, "Bold", group=GR, display=display.none, inline="rt2",
    tooltip="Bold the High and Low labels. The 50% and quarter labels have their own Bold on the Mid Line and Quarters rows.")
bool   rt_mid  = input.bool(true, "Mid Line", group=GR, display=display.none, inline="rt3")
string rt_msty = input.string("Dotted", "", options=["Solid","Dashed","Dotted"], group=GR, display=display.none, inline="rt3")
int    rt_mw   = input.int(2, "", minval=1, maxval=10, group=GR, display=display.none, inline="rt3")
bool   rt_mb   = input.bool(true, "Bold", group=GR, display=display.none, inline="rt3")
bool   rt_mlbl = input.bool(true, "Label", group=GR, display=display.none, inline="rt3",
    tooltip="Show the 50% label. Off draws the mid line without any text.")
bool   rt_qtr  = input.bool(true, "Quarters", group=GR, display=display.none, inline="rt4")
string rt_qsty = input.string("Dotted", "", options=["Solid","Dashed","Dotted"], group=GR, display=display.none, inline="rt4")
int    rt_qw   = input.int(2, "", minval=1, maxval=10, group=GR, display=display.none, inline="rt4")
bool   rt_qb   = input.bool(true, "Bold", group=GR, display=display.none, inline="rt4")
bool   rt_qlbl = input.bool(true, "Label", group=GR, display=display.none, inline="rt4",
    tooltip="Show the 25% and 75% labels. Off draws the quarter lines without any text.")
string rt_mkt  = input.string("Auto", "Market", options=["Auto","Equity Index","Treasuries","Crude Oil","Natural Gas","Gold","Silver","Copper","Custom"],
    group=GR, display=display.none,
    tooltip="Sets the regular session the gap runs between (New York time): Equity Index 09:30-16:15, Treasuries 08:20-15:00, Crude Oil and Natural Gas 09:00-14:30, Gold 08:20-13:30, Silver 08:25-13:25, Copper 08:10-13:00. Auto picks from the chart's own symbol: ZT, ZF, ZN, TN, ZB, TWE, UB = Treasuries; CL, MCL, QM = Crude Oil; NG, MNG, QG = Natural Gas; GC, MGC, QO, 1OZ = Gold; SI, SIL, QI, SIC = Silver; HG, MHG, QC = Copper; anything else = Equity Index.")
string rt_hrs  = input.session("0930-1615", "Custom Hours", group=GR, display=display.none,
    tooltip="Used when Market is Custom: the regular session's open and close, New York time, within one day.")
string rt_px   = input.string("Auto", "Close Price", options=["Auto","Settlement","Last Trade"], group=GR, display=display.none,
    tooltip="What the gap is measured from. Last Trade: the last trade before the session close (e.g. 16:14 for Equity Index). Settlement: the daily settlement price; its line starts on the latest candle before the close that traded that price. Auto: Last Trade for Equity Index and Custom, Settlement for every other market. 1OZ and SIC always use Last Trade.")

// ===========================================================================
// INPUTS - NWOG / NDOG
// ===========================================================================
string GNW = "NWOG"
bool   nw_on   = input.bool(true, "New Week Opening Gap", group=GNW, display=display.none,
