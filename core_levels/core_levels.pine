color  w_tcol2 = input.color(#801922, "Low Text", group=GW, display=display.none, inline="w4")
string w_tsz2  = input.string("Small", "", options=["Tiny","Small","Normal","Large"], group=GW, display=display.none, inline="w4")
bool   w_tb2   = input.bool(true, "Bold", group=GW, display=display.none, inline="w4")
string w_take  = input.string("Keep", "When Taken", options=["Keep","Stop at take","Remove"], group=GW, display=display.none, tooltip=TAKE_TIP)

string GD = "Previous Day"
bool   d_on    = input.bool(true, "Previous Day High / Low", group=GD, display=display.none,
    tooltip="The high and low of the last completed trading day (18:00 to 17:00 New York for CME futures). Lines start on the candle that set each price. Shown on daily and lower charts.")
color  d_lcol  = input.color(#2962FF, "High Line", group=GD, display=display.none, inline="d1")
string d_lsty  = input.string("Solid", "", options=["Solid","Dashed","Dotted"], group=GD, display=display.none, inline="d1")
int    d_lw    = input.int(2, "", minval=1, maxval=10, group=GD, display=display.none, inline="d1")
color  d_tcol  = input.color(#2962FF, "High Text", group=GD, display=display.none, inline="d2")
string d_tsz   = input.string("Small", "", options=["Tiny","Small","Normal","Large"], group=GD, display=display.none, inline="d2")
bool   d_tb    = input.bool(true, "Bold", group=GD, display=display.none, inline="d2")
color  d_lcol2 = input.color(#801922, "Low Line", group=GD, display=display.none, inline="d3")
string d_lsty2 = input.string("Solid", "", options=["Solid","Dashed","Dotted"], group=GD, display=display.none, inline="d3")
int    d_lw2   = input.int(2, "", minval=1, maxval=10, group=GD, display=display.none, inline="d3")
color  d_tcol2 = input.color(#801922, "Low Text", group=GD, display=display.none, inline="d4")
string d_tsz2  = input.string("Small", "", options=["Tiny","Small","Normal","Large"], group=GD, display=display.none, inline="d4")
bool   d_tb2   = input.bool(true, "Bold", group=GD, display=display.none, inline="d4")
string d_take  = input.string("Keep", "When Taken", options=["Keep","Stop at take","Remove"], group=GD, display=display.none, tooltip=TAKE_TIP)

bool   pc_on   = input.bool(true, "Previous Day Close", group=GD, display=display.none,
    tooltip="The close of the last completed trading day. The line starts on that day's last candle and always runs to its label.")
color  pc_lcol = input.color(#000000, "Line", group=GD, display=display.none, inline="pc1")
string pc_lsty = input.string("Dashed", "", options=["Solid","Dashed","Dotted"], group=GD, display=display.none, inline="pc1")
int    pc_lw   = input.int(1, "", minval=1, maxval=10, group=GD, display=display.none, inline="pc1")
color  pc_tcol = input.color(#000000, "Text", group=GD, display=display.none, inline="pc2")
string pc_tsz  = input.string("Small", "", options=["Tiny","Small","Normal","Large"], group=GD, display=display.none, inline="pc2")
bool   pc_tb   = input.bool(true, "Bold", group=GD, display=display.none, inline="pc2")
string cl_md   = input.string("Settlement", "Close Price", options=["Settlement","Last Trade"], group=GD, display=display.none,
    tooltip="Settlement: the daily candle's close, which is the settlement price for CME futures. Last Trade: the close of the day's last chart candle.")

// ===========================================================================
// INPUTS - SESSIONS
// ===========================================================================
string SESS_TIP = "New York time. The high and low appear when the session ends and stay until the next one ends. Lines start on the candle that set each price. Shown on 1-hour and lower charts."

string GA = "Asia"
bool   a_on    = input.bool(true, "Asia High / Low", group=GA, display=display.none, inline="a0")
string a_sess  = input.session("1800-0100", "", group=GA, display=display.none, inline="a0", tooltip=SESS_TIP)
