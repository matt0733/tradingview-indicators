//@version=6
indicator("Core Levels 1.2.0", shorttitle="Core Levels", overlay=true,
          max_lines_count=500, max_labels_count=500)

// Marks the current set of reference levels for Bar Replay and live charts:
// previous month, week and day highs and lows, the previous day close, the latest
// completed Asia and London session highs and lows, the Midnight Open and the
// premarket high and low. Every level is found from the chart's own bars as they
// arrive (monthly, weekly and daily prices come from the higher-timeframe candle),
// so nothing looks ahead in Bar Replay.

// ===========================================================================
// INPUTS - GENERAL
// ===========================================================================
string GEN = "General"
int    lbl_off  = input.int(10, "Label Offset (bars)", minval=0, maxval=500, group=GEN, display=display.none,
    tooltip="How far past the current bar the labels sit. Untaken lines run to their label.")
bool   show_px  = input.bool(true, "Show Price in Label", group=GEN, display=display.none)
bool   spread_on = input.bool(true, "Spread Overlapping Labels", group=GEN, display=display.none,
    tooltip="When labels sit closer than the spacing below, space them out evenly around their prices, each joined to its own line by a short leader. Turn off to leave every label level with its line.")
float  lbl_gap  = input.float(2.0, "Label Spacing (% of view)", minval=0, maxval=20, step=0.5, group=GEN, display=display.none,
    tooltip="Roughly the height of one label, as a share of the chart's visible price range. Labels closer together than this are spaced out evenly around their prices. The visible range is re-measured as you zoom and scroll.")
int    max_move = input.int(0, "Max Label Move (label heights)", minval=0, maxval=20, group=GEN, display=display.none,
    tooltip="0 = no limit. A label that would have to move further than this many label heights stays on its own line instead, even if it then touches another label.")
bool   crowd_off = input.bool(false, "Skip Spread When Crowded", group=GEN, display=display.none,
    tooltip="When more labels are in view than fit at the Label Spacing, leave every label on its own line instead of spreading them.")

string TAKE_TIP = "What happens once price trades through one of these levels (a wick touch counts). Keep: the line runs on to its label. Stop at take: the line ends at the candle that took it and the label moves to the middle of the line - above it for highs, below it for lows. Remove: the line and label are deleted."

// ===========================================================================
// INPUTS - HIGHS AND LOWS
// ===========================================================================
string GM = "Previous Month"
bool   m_on    = input.bool(true, "Previous Monthly High / Low", group=GM, display=display.none,
    tooltip="The high and low of the last completed month (CME trading days for futures). Lines start on the candle that set each price, or at the chart's first bar when that candle is older than the chart. Shown on monthly and lower charts.")
color  m_lcol  = input.color(#2962FF, "High Line", group=GM, display=display.none, inline="m1")
string m_lsty  = input.string("Solid", "", options=["Solid","Dashed","Dotted"], group=GM, display=display.none, inline="m1")
int    m_lw    = input.int(2, "", minval=1, maxval=10, group=GM, display=display.none, inline="m1")
color  m_tcol  = input.color(#2962FF, "High Text", group=GM, display=display.none, inline="m2")
string m_tsz   = input.string("Small", "", options=["Tiny","Small","Normal","Large"], group=GM, display=display.none, inline="m2")
bool   m_tb    = input.bool(true, "Bold", group=GM, display=display.none, inline="m2")
color  m_lcol2 = input.color(#801922, "Low Line", group=GM, display=display.none, inline="m3")
string m_lsty2 = input.string("Solid", "", options=["Solid","Dashed","Dotted"], group=GM, display=display.none, inline="m3")
int    m_lw2   = input.int(2, "", minval=1, maxval=10, group=GM, display=display.none, inline="m3")
color  m_tcol2 = input.color(#801922, "Low Text", group=GM, display=display.none, inline="m4")
string m_tsz2  = input.string("Small", "", options=["Tiny","Small","Normal","Large"], group=GM, display=display.none, inline="m4")
bool   m_tb2   = input.bool(true, "Bold", group=GM, display=display.none, inline="m4")
string m_take  = input.string("Keep", "When Taken", options=["Keep","Stop at take","Remove"], group=GM, display=display.none, tooltip=TAKE_TIP)

string GW = "Previous Week"
bool   w_on    = input.bool(true, "Previous Weekly High / Low", group=GW, display=display.none,
    tooltip="The high and low of the last completed week. Lines start on the candle that set each price, or at the chart's first bar when that candle is older than the chart. Shown on weekly and lower charts.")
color  w_lcol  = input.color(#2962FF, "High Line", group=GW, display=display.none, inline="w1")
string w_lsty  = input.string("Dotted", "", options=["Solid","Dashed","Dotted"], group=GW, display=display.none, inline="w1")
int    w_lw    = input.int(2, "", minval=1, maxval=10, group=GW, display=display.none, inline="w1")
color  w_tcol  = input.color(#2962FF, "High Text", group=GW, display=display.none, inline="w2")
string w_tsz   = input.string("Small", "", options=["Tiny","Small","Normal","Large"], group=GW, display=display.none, inline="w2")
bool   w_tb    = input.bool(true, "Bold", group=GW, display=display.none, inline="w2")
color  w_lcol2 = input.color(#801922, "Low Line", group=GW, display=display.none, inline="w3")
string w_lsty2 = input.string("Dotted", "", options=["Solid","Dashed","Dotted"], group=GW, display=display.none, inline="w3")
