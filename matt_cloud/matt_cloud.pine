//@version=6
indicator("Matt Cloud 1.0.2", shorttitle="Matt Cloud", overlay=true)

// Three moving averages of the source with two clouds between them:
// a fast 4 EMA (Short), a 20 EMA (Lead) and a 20 SMA (K). Each line is colored
// by its own slope. The Short/Lead cloud shows trend direction (bull while Short
// is above Lead); the K/Lead cloud uses the same bull/bear state.

shortLen = input.int(4,  "Short EMA length", minval=1)
leadLen  = input.int(20, "Lead EMA length",  minval=1)
kLen     = input.int(20, "K SMA length",     minval=1)
src      = input.source(close, "Source")

bullLine   = input.color(color.new(#008000, 50), "Line up")
bearLine   = input.color(color.new(#FF0000, 50), "Line down")
bullCloud  = input.color(color.new(#64FFDA, 80), "Cloud bull")
bearCloud  = input.color(color.new(#F43E32, 80), "Cloud bear")
bullKCloud = input.color(color.new(#64FFDA, 50), "K-Lead cloud bull")
bearKCloud = input.color(color.new(#F43E32, 50), "K-Lead cloud bear")

mcShort = ta.ema(src, shortLen)
mcLead  = ta.ema(src, leadLen)
mcK     = ta.sma(src, kLen)

bull = mcShort > mcLead

shortCol = mcShort > mcShort[1] ? bullLine : bearLine
leadCol  = mcLead  > mcLead[1]  ? bullLine : bearLine
kCol     = mcK     >= mcK[1]    ? bullLine : bearLine

pShort = plot(mcShort, "MC Short", shortCol)
pLead  = plot(mcLead,  "MC Lead",  leadCol)
pK     = plot(mcK,     "MC K",     kCol)

fill(pShort, pLead, bull ? bullCloud : bearCloud, "MC Cloud")
fill(pK,     pLead, bull ? bullKCloud : bearKCloud, "MC K Lead Cloud")

alertcondition(ta.crossover(mcShort, mcLead),  "Cloud flip bull", "Matt Cloud turned bullish")
alertcondition(ta.crossunder(mcShort, mcLead), "Cloud flip bear", "Matt Cloud turned bearish")
