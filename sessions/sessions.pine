//@version=6
indicator("Sessions 1.7.0", shorttitle="Sessions", overlay=true,
          max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS — GENERAL
// ═══════════════════════════════════════════════════════════════════════════
string GEN = "General"
string tz       = input.string("America/New_York", "Timezone",
    options=["America/New_York","America/Chicago","America/Los_Angeles",
             "Europe/London","Europe/Berlin","Asia/Tokyo","Asia/Singapore"],
    group=GEN)
int    prev_days   = input.int(20, "Show Previous Sessions", minval=0, maxval=20, group=GEN)
string bsty_in     = input.string("None", "Box Border Style",
    options=["None","Solid","Dashed","Dotted"], group=GEN)
int    bw_in       = input.int(1, "Box Border Width", minval=1, maxval=4, group=GEN)
int    extend_bars = input.int(5, "H-Line Extension (bars)", minval=0, maxval=500, group=GEN)
bool   show_mid    = input.bool(false, "Show Session Midpoint", group=GEN, tooltip="Draw a horizontal line at (High + Low) / 2 inside each session's box. Uses the session's own color. Terminates at the end of the session box.")
string mid_sty_in  = input.string("Dashed", "Midpoint Style", options=["Solid","Dashed","Dotted"], group=GEN)
int    mid_w       = input.int(1, "Midpoint Thickness", minval=1, maxval=4, group=GEN)


