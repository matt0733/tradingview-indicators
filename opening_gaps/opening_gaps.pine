          max_lines_count=500, max_labels_count=500)

// ===========================================================================
// INPUTS - GENERAL
// ===========================================================================
string GEN = "『 GENERAL 』"
int ext_bars = input.int(20, "Extend Right (bars)", minval=0, maxval=500, group=GEN, display=display.none,
    tooltip="How far past the current bar every gap line reaches. Labels sit at the right end of the lines.")
bool  spread_on = input.bool(true, "Spread Overlapping Labels", group=GEN, display=display.none,
    tooltip="When labels sit closer than the spacing below, space them out evenly around their prices, each joined to its own line by a short leader. Turn off to leave every label level with its line.")
float lbl_gap   = input.float(2.0, "Label Spacing (% of view)", minval=0, maxval=20, step=0.5, group=GEN, display=display.none,
    tooltip="Roughly the height of one label, as a share of the chart's visible price range. Labels closer together than this are spread. The visible range is re-measured as you zoom and scroll. Raise it if labels still touch, lower it if they spread out when they don't need to.")
int   max_move  = input.int(0, "Max Label Move (label heights)", minval=0, maxval=20, group=GEN, display=display.none,
    tooltip="0 = no limit. A label that would have to move further than this many label heights stays on its own line instead, even if it then touches another label.")
bool  crowd_off = input.bool(false, "Skip Spread When Crowded", group=GEN, display=display.none,
    tooltip="When more labels are in view than fit at the Label Spacing, leave every label on its own line instead of spreading them.")

