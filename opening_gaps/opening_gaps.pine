// ===========================================================================
// TYPES
// ===========================================================================
type GapCfg
    string name
    bool   on
    bool   hl     // label only High and Low (previous gaps)
    int    keep
    bool   date
    color  lcol
    string lsty
    int    lw
    color  tcol
    string tsz
    string tpos
    bool   mid
    string msty
    int    mw
    bool   qtr
    string qsty
    int    qw

type Gap
    float         pc     // prior close
    int           pc_t
    float         op     // open
    int           op_t
    array<line>   lines
    array<label>  labels
    array<color>  cols   // per level, so a leader can match its line
    array<string> stys
    array<int>    wids

// ===========================================================================
// HELPERS
// ===========================================================================
const string TZ = "America/New_York"

const int S_RTH_OPEN  = 9 * 3600 + 30 * 60
const int S_HOLIDAY   = 13 * 3600
const int S_RTH_CLOSE = 16 * 3600 + 15 * 60
const int S_HALT      = 17 * 3600
const int S_REOPEN    = 18 * 3600

ls(s) =>
    switch s
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        =>          line.style_solid

lbl_sz(s) =>
    switch s
        "Tiny"   => size.tiny
        "Normal" => size.normal
        "Large"  => size.large
        =>          size.small

lbl_sty(pos) =>
    switch pos
        "Top"    => label.style_label_lower_left
        "Bottom" => label.style_label_upper_left
        =>          label.style_label_left

f_mmdd(t) =>
    m = month(t, TZ)
    d = dayofmonth(t, TZ)
    (m < 10 ? "0" : "") + str.tostring(m) + "/" + (d < 10 ? "0" : "") + str.tostring(d)

draw_level(Gap g, GapCfg c, int x1, int x2, float y, string sty, int w, string txt) =>
    g.lines.push(line.new(x1, y, x2, y, xloc=xloc.bar_time, color=c.lcol, style=ls(sty), width=w))
    g.cols.push(c.lcol)
    g.stys.push(sty)
    g.wids.push(w)
    g.labels.push(label.new(x2, y, txt, xloc=xloc.bar_time, style=lbl_sty(c.tpos),
                            color=color.new(color.white, 100), textcolor=c.tcol,
                            size=lbl_sz(c.tsz), textalign=text.align_left))

// Draws one gap in the given styling: High/Low from where each price was set,
// mid/quarters from the open. Percent levels run from the open toward the prior
// close (25% = a quarter filled). Labels carry the open's date when asked for.
draw_gap(Gap g, GapCfg c, int x2) =>
    string dt = c.date ? " " + f_mmdd(g.op_t) : ""
    bool gap_dn = g.pc >= g.op
    draw_level(g, c, gap_dn ? g.pc_t : g.op_t, x2, math.max(g.pc, g.op), c.lsty, c.lw, c.name + " High" + dt)
    draw_level(g, c, gap_dn ? g.op_t : g.pc_t, x2, math.min(g.pc, g.op), c.lsty, c.lw, c.name + " Low" + dt)
    float span = g.pc - g.op
    bool pct_txt = not c.hl   // blank percent labels if this block labels High/Low only
    if c.qtr
        draw_level(g, c, g.op_t, x2, g.op + span * 0.25, c.qsty, c.qw, pct_txt ? c.name + " 25%" + dt : "")
        draw_level(g, c, g.op_t, x2, g.op + span * 0.75, c.qsty, c.qw, pct_txt ? c.name + " 75%" + dt : "")
    if c.mid
        draw_level(g, c, g.op_t, x2, g.op + span * 0.5, c.msty, c.mw, pct_txt ? c.name + " 50%" + dt : "")

clear_gap(Gap g) =>
    for l in g.lines
        l.delete()
    for lb in g.labels
        lb.delete()
    g.lines.clear()
    g.labels.clear()
    g.cols.clear()
    g.stys.clear()
    g.wids.clear()

// Redraws a whole store: the newest gap in the Current styling, the ones behind
// it in the Previous styling, and trims records past what Previous asks for.
// Each switch stands alone, so Previous on with Current off hides only the newest.
redraw(array<Gap> store, GapCfg cur, GapCfg prv, int x2) =>
    int keep_n = (prv.on ? prv.keep : 0) + 1
    while store.size() > keep_n
        clear_gap(store.shift())
    int n = store.size()
    if n > 0
        for i = 0 to n - 1
            Gap g = store.get(i)
            clear_gap(g)
            int age = n - 1 - i        // 0 = current, 1+ = previous
            if age == 0
                if cur.on
                    draw_gap(g, cur, x2)
            else if prv.on
                draw_gap(g, prv, x2)

add_gap(array<Gap> store, GapCfg cur, GapCfg prv, float pc, int pc_t, float op, int op_t, int x2) =>
    store.push(Gap.new(pc, pc_t, op, op_t, array.new<line>(), array.new<label>(), array.new<color>(), array.new<string>(), array.new<int>()))
    redraw(store, cur, prv, x2)
    log.info("{0}: close {1} -> open {2} ({3} pts)", cur.name,
             str.tostring(pc, format.mintick), str.tostring(op, format.mintick),
             str.tostring(op - pc, format.mintick))

// Removes the newest gap. Used when a day turns out to be a holiday with no
// regular session, which promotes the one behind it back to current.
drop_newest(array<Gap> store, GapCfg cur, GapCfg prv, int x2) =>
    if store.size() > 0
        Gap g = store.pop()
        clear_gap(g)
        redraw(store, cur, prv, x2)
        log.info("{0}: dropped holiday gap {1} -> {2}", cur.name,
                 str.tostring(g.pc, format.mintick), str.tostring(g.op, format.mintick))

extend_all(array<Gap> store, int x2) =>
    for g in store
        int n = g.lines.size()
        if n > 0
            for i = 0 to n - 1
                line  l  = g.lines.get(i)
                label lb = g.labels.get(i)
                l.set_x2(x2)
                lb.set_x(x2)
                lb.set_y(l.get_y1())

// Gathers every drawn level from a store into the parallel arrays used by the spread
collect_levels(array<Gap> store, array<label> lbs, array<line> lns, array<float> ys,
               array<color> cs, array<string> ss, array<int> ws) =>
    for g in store
        int n = g.labels.size()
        if n > 0
            for i = 0 to n - 1
                if g.labels.get(i).get_text() == ""
                    continue
                lbs.push(g.labels.get(i))
                lns.push(g.lines.get(i))
                ys.push(g.lines.get(i).get_y1())
                cs.push(g.cols.get(i))
                ss.push(g.stys.get(i))
                ws.push(g.wids.get(i))

// The RTH gap as seen on a lower series, for chart timeframes that cannot
// resolve 09:30 and 16:15 exactly. Returns the current gap and the open time of
// any gap withdrawn as a holiday. All values persist, so they survive being
// aggregated onto a slower chart bar; the chart side acts when they change.
rth_state() =>
    var float pc       = na    // close before 16:15 of the last real session
    var int   pc_t     = na
    var float day_c    = na    // running close before 16:15 today
    var int   day_c_t  = na
    var bool  day_ok   = false // today traded past 13:00
    var bool  pend     = false
    var int   cur_op_t = 0
    var float cur_op   = na
    var float cur_pc   = na
    var int   cur_pc_t = 0
    var int   drop_t   = 0
    int tfs  = timeframe.in_seconds()
    int sod2 = hour(time, TZ) * 3600 + minute(time, TZ) * 60 + second(time, TZ)
    int dow2 = dayofweek(time, TZ)
    if sod2 <= S_RTH_OPEN and S_RTH_OPEN < sod2 + tfs and dow2 >= dayofweek.monday and dow2 <= dayofweek.friday
        if day_ok
            pc   := day_c
            pc_t := day_c_t
        day_ok := false
        if not na(pc) and pc != open
            cur_op_t := time
            cur_op   := open
            cur_pc   := pc
            cur_pc_t := pc_t
            pend     := true
    if sod2 >= S_RTH_OPEN and sod2 < S_RTH_CLOSE
        day_c   := close
        day_c_t := time
    if sod2 >= S_HOLIDAY and sod2 < S_HALT
        day_ok := true
        pend   := false
    else if pend and (sod2 >= S_HALT or sod2 < S_RTH_OPEN)
        drop_t := cur_op_t
        pend   := false
    [cur_op_t, cur_op, cur_pc, cur_pc_t, drop_t]

// ---------------------------------------------------------------------------
// Backfill. A 1m chart only loads a few weeks of bars, but a request.security
// context runs over its own, longer history. These scanners run inside such a
// context and return the most recent gaps as a flat array of
// [open time, open, prior close, prior close time] per gap, oldest first.
// Their prices are the same trades the chart would use: a 60m bar closing at the
// 17:00 halt closes on the 16:59 trade and the 18:00 bar opens on the 18:00
// trade; a 15m bar closes at 16:15 on the 16:14 trade and opens at 09:30.
// ---------------------------------------------------------------------------
eve_scan(bool weekly) =>
    var float pc   = na
    var int   pc_t = na
    var array<float> g = array.new<float>()
    int tfs = timeframe.in_seconds()
    int s   = hour(time, TZ) * 3600 + minute(time, TZ) * 60 + second(time, TZ)
    int d   = dayofweek(time, TZ)
    if s <= S_REOPEN and S_REOPEN < s + tfs and not na(pc) and pc != open
        bool day_ok = weekly ? d == dayofweek.sunday : d >= dayofweek.monday and d <= dayofweek.thursday
        if day_ok
            g.push(time), g.push(open), g.push(pc), g.push(pc_t)
            while g.size() > 24
                g.shift()
    if s < S_HALT
        pc   := close
        pc_t := time_close - 60000    // last minute of the bar, e.g. 16:59
    g.copy()

rth_scan() =>
    var float pc      = na
    var int   pc_t    = na
    var float day_c   = na
    var int   day_c_t = na
    var bool  day_ok  = false
    var bool  pend    = false
    var array<float> g = array.new<float>()
    int tfs = timeframe.in_seconds()
    int s   = hour(time, TZ) * 3600 + minute(time, TZ) * 60 + second(time, TZ)
    int d   = dayofweek(time, TZ)
    if s <= S_RTH_OPEN and S_RTH_OPEN < s + tfs and d >= dayofweek.monday and d <= dayofweek.friday
        if day_ok
            pc   := day_c
            pc_t := day_c_t
        day_ok := false
        if not na(pc) and pc != open
            g.push(time), g.push(open), g.push(pc), g.push(pc_t)
            while g.size() > 28       // one spare, so a dropped holiday doesn't cost a gap
                g.shift()
            pend := true
    if s >= S_RTH_OPEN and s < S_RTH_CLOSE
        day_c   := close
        day_c_t := time_close - 60000 // last minute of the bar, e.g. 16:14
    if s >= S_HOLIDAY and s < S_HALT
        day_ok := true
        pend   := false
    else if pend and (s >= S_HALT or s < S_RTH_OPEN)
        // Halted before 13:00: a holiday with no regular session
        for k = 1 to 4
            g.pop()
        pend := false
    g.copy()

// Adds backfilled gaps the chart's own bars could not reach, skipping any it
// already found (matched on open time), and keeps the store in time order.
merge_backfill(array<Gap> store, GapCfg cur, GapCfg prv, array<float> bf, int x2) =>
    int n = na(bf) ? 0 : bf.size() / 4
    int added = 0
    if n > 0
        for i = 0 to n - 1
            int  opt = int(bf.get(i * 4))
            int  pos = 0
            bool dup = false
            int  m   = store.size()
            if m > 0
                for j = 0 to m - 1
                    int t = store.get(j).op_t
                    if t == opt
                        dup := true
                    if t < opt
                        pos := j + 1
            if not dup
                store.insert(pos, Gap.new(bf.get(i * 4 + 2), int(bf.get(i * 4 + 3)), bf.get(i * 4 + 1), opt,
                                          array.new<line>(), array.new<label>(), array.new<color>(), array.new<string>(), array.new<int>()))
                added += 1
        redraw(store, cur, prv, x2)
    log.info("{0}: backfilled {1} of {2}", cur.name, added, n)

// ===========================================================================
// STATE
// ===========================================================================
var GapCfg nwc = GapCfg.new("NWOG", nwc_on, false, 1,        nwc_date, nwc_lcol, nwc_lsty, nwc_lw, nwc_tcol, nwc_tsz, nwc_tpos, nwc_mid, nwc_msty, nwc_mw, nwc_qtr, nwc_qsty, nwc_qw)
var GapCfg nwp = GapCfg.new("NWOG", nwp_on, nwp_hl, nwp_keep, nwp_date, nwp_lcol, nwp_lsty, nwp_lw, nwp_tcol, nwp_tsz, nwp_tpos, nwp_mid, nwp_msty, nwp_mw, nwp_qtr, nwp_qsty, nwp_qw)
var GapCfg ndc = GapCfg.new("NDOG", ndc_on, false, 1,        ndc_date, ndc_lcol, ndc_lsty, ndc_lw, ndc_tcol, ndc_tsz, ndc_tpos, ndc_mid, ndc_msty, ndc_mw, ndc_qtr, ndc_qsty, ndc_qw)
var GapCfg ndp = GapCfg.new("NDOG", ndp_on, ndp_hl, ndp_keep, ndp_date, ndp_lcol, ndp_lsty, ndp_lw, ndp_tcol, ndp_tsz, ndp_tpos, ndp_mid, ndp_msty, ndp_mw, ndp_qtr, ndp_qsty, ndp_qw)
var GapCfg rtc = GapCfg.new("RTH",  rtc_on, false, 1,        rtc_date, rtc_lcol, rtc_lsty, rtc_lw, rtc_tcol, rtc_tsz, rtc_tpos, rtc_mid, rtc_msty, rtc_mw, rtc_qtr, rtc_qsty, rtc_qw)
var GapCfg rtp = GapCfg.new("RTH",  rtp_on, rtp_hl, rtp_keep, rtp_date, rtp_lcol, rtp_lsty, rtp_lw, rtp_tcol, rtp_tsz, rtp_tpos, rtp_mid, rtp_msty, rtp_mw, rtp_qtr, rtp_qsty, rtp_qw)

var array<Gap> nw_gaps = array.new<Gap>()
var array<Gap> nd_gaps = array.new<Gap>()
var array<Gap> rt_gaps = array.new<Gap>()

var float eve_close   = na    // last bar starting before 17:00
var int   eve_close_t = na

// RTH close is only carried forward from a real session. Holiday Globex sessions
// (Labor Day, Presidents Day, ...) still print a 09:30 bar but halt at 13:00, so a
// day counts only once it trades past 13:00 - early-close days run to 13:15.
var float rth_close   = na    // close before 16:15 of the last real RTH session
var int   rth_close_t = na
var float day_close   = na    // running close before 16:15 today
var int   day_close_t = na
var bool  day_real    = false // today traded past 13:00
var bool  rt_pending  = false // today's RTH gap is waiting on day_real

// ===========================================================================
// PROCESSING
// ===========================================================================
int  tf_sec = timeframe.in_seconds()
bool tf_ok  = tf_sec < 86400
bool rth_native = tf_ok and 900 % tf_sec == 0   // chart resolves 09:30 and 16:15 exactly

// Source timeframe for charts whose own bars cannot place 09:30 and 16:15: the
// largest size that divides 15 minutes and is no larger than the chart's own, so
// its bars have already closed inside the chart bar and nothing is drawn late.
string rth_src = tf_sec >= 900 ? "15" : tf_sec >= 300 ? "5" : tf_sec >= 180 ? "3" : "1"

// Read unconditionally: request.* must sit in the global scope. Only used when
// the chart's own bars cannot place the boundaries.
[h_op_t, h_op, h_pc, h_pc_t, h_drop] = request.security(syminfo.tickerid, rth_src, rth_state(),
     lookahead=barmerge.lookahead_off)

// Backfill sources: 60m for NWOG/NDOG (their 17:00 and 18:00 boundaries are
// hourly bar edges), 15m for RTH (60m would straddle 09:30 and 16:15).
array<float> nw_bf = request.security(syminfo.tickerid, "60", eve_scan(true),  lookahead=barmerge.lookahead_off)
array<float> nd_bf = request.security(syminfo.tickerid, "60", eve_scan(false), lookahead=barmerge.lookahead_off)
array<float> rt_bf = request.security(syminfo.tickerid, "15", rth_scan(),      lookahead=barmerge.lookahead_off)

int  sod   = hour(time, TZ) * 3600 + minute(time, TZ) * 60 + second(time, TZ)
int  dow   = dayofweek(time, TZ)
int  x_end = time + ext_bars * tf_sec * 1000

// True only on the bar whose span contains the given second of the day
contains(int s) =>
    sod <= s and s < sod + tf_sec

if tf_ok
    // 18:00 reopen - Sunday is NWOG, Monday-Thursday is NDOG
    if contains(S_REOPEN) and not na(eve_close) and eve_close != open
        if dow == dayofweek.sunday
            add_gap(nw_gaps, nwc, nwp, eve_close, eve_close_t, open, time, x_end)
        else if dow >= dayofweek.monday and dow <= dayofweek.thursday
            add_gap(nd_gaps, ndc, ndp, eve_close, eve_close_t, open, time, x_end)
    if sod < S_HALT
        eve_close   := close
        eve_close_t := time

if rth_native
    // 09:30 open, Monday-Friday, straight from the chart's own bars
    if contains(S_RTH_OPEN) and dow >= dayofweek.monday and dow <= dayofweek.friday
        if day_real
            rth_close   := day_close
            rth_close_t := day_close_t
        day_real := false
        if not na(rth_close) and rth_close != open
            add_gap(rt_gaps, rtc, rtp, rth_close, rth_close_t, open, time, x_end)
            rt_pending := true
    if sod >= S_RTH_OPEN and sod < S_RTH_CLOSE
        day_close   := close
        day_close_t := time
    if sod >= S_HOLIDAY and sod < S_HALT
        day_real   := true
        rt_pending := false
    else if rt_pending and (sod >= S_HALT or sod < S_RTH_OPEN)
        // Halted before 13:00: no regular session today, so drop its gap
        drop_newest(rt_gaps, rtc, rtp, x_end)
        rt_pending := false
else if tf_ok
    // 2m, 10m, 30m, 1h, 4h ... - the gap comes from rth_src, whose bars close
    // inside the chart bar, so it appears with the chart bar holding 09:30.
    if h_op_t != 0 and h_op_t != nz(h_op_t[1], 0)
        add_gap(rt_gaps, rtc, rtp, h_pc, h_pc_t, h_op, h_op_t, x_end)
    if h_drop != 0 and h_drop != nz(h_drop[1], 0)
        drop_newest(rt_gaps, rtc, rtp, x_end)

// Once history has loaded, fill in gaps from before the chart's first bar. Gaps
// that form after this keep coming from the chart's own bars, so the current
// gap still appears the moment it opens.
if barstate.islastconfirmedhistory and tf_ok
    merge_backfill(nw_gaps, nwc, nwp, nw_bf, x_end)
    merge_backfill(nd_gaps, ndc, ndp, nd_bf, x_end)
    merge_backfill(rt_gaps, rtc, rtp, rt_bf, x_end)

// High and low of the bars in view; the script recalculates when the view changes
var float vis_hi = na
var float vis_lo = na
if time >= chart.left_visible_bar_time and time <= chart.right_visible_bar_time
    vis_hi := na(vis_hi) ? high : math.max(vis_hi, high)
    vis_lo := na(vis_lo) ? low  : math.min(vis_lo, low)

const int LEAD_BARS = 3   // length of a leader to a moved label
var array<line> leaders = array.new<line>()

if barstate.islast
    extend_all(nw_gaps, x_end)
    extend_all(nd_gaps, x_end)
    extend_all(rt_gaps, x_end)
    for l in leaders
        l.delete()
    leaders.clear()

    // Labels closer than one label height (thr) are spaced out evenly around their
    // prices, highest at the top. Each moved label gets a short leader from the end
    // of its line, which then stops LEAD_BARS short of the label. Labels with room
    // stay on their line. Works top-down in blocks: a label that overlaps the block
    // above joins it, and the block is re-centred on its members' prices (which can
    // make it overlap the next block up, so merging repeats). Same as Key Levels.
    if spread_on
        array<label>  lbs = array.new<label>()
        array<line>   lns = array.new<line>()
        array<float>  ys  = array.new<float>()
        array<color>  cs  = array.new<color>()
        array<string> ss  = array.new<string>()
        array<int>    ws  = array.new<int>()
        collect_levels(nw_gaps, lbs, lns, ys, cs, ss, ws)
        collect_levels(nd_gaps, lbs, lns, ys, cs, ss, ws)
        collect_levels(rt_gaps, lbs, lns, ys, cs, ss, ws)
        float tol = syminfo.mintick / 2
        float thr = math.max(nz(vis_hi - vis_lo) * lbl_gap / 100, tol)
        int   x_ldr = x_end - math.min(LEAD_BARS, ext_bars) * tf_sec * 1000   // where a leader starts
        int   n   = lbs.size()
        // Crowded: more labels in view than fit one label height apart
        int n_vis = 0
        for y in ys
            if y >= vis_lo and y <= vis_hi
                n_vis += 1
        bool crowded = crowd_off and n_vis * thr > nz(vis_hi - vis_lo)
        if n > 1 and not crowded
            array<int>   ord   = ys.sort_indices(order.descending)
            array<float> b_top = array.new<float>()   // y of each block's first label
            array<float> b_sum = array.new<float>()   // sum of its members' prices
            array<int>   b_len = array.new<int>()
            for i = 0 to n - 1
                float p = ys.get(ord.get(i))
                b_top.push(p)
                b_sum.push(p)
                b_len.push(1)
                while b_top.size() > 1
                    int   m     = b_top.size()
                    float above = b_top.get(m - 2) - (b_len.get(m - 2) - 1) * thr   // lowest y of block above
                    if b_top.get(m - 1) > above - thr
                        float sum = b_sum.get(m - 2) + b_sum.get(m - 1)
                        int   len = b_len.get(m - 2) + b_len.get(m - 1)
                        b_top.pop()
                        b_sum.pop()
                        b_len.pop()
                        b_top.set(m - 2, sum / len + (len - 1) * thr / 2)
                        b_sum.set(m - 2, sum)
                        b_len.set(m - 2, len)
                    else
                        break
            int k = 0
            for b = 0 to b_top.size() - 1
                for r = 0 to b_len.get(b) - 1
                    int   idx = ord.get(k)
                    float y   = b_top.get(b) - r * thr
                    float p   = ys.get(idx)
                    // Past the move limit a label stays on its own line
                    bool too_far = max_move > 0 and math.abs(y - p) > max_move * thr + tol
                    if math.abs(y - p) > tol and not too_far
                        lns.get(idx).set_x2(x_ldr)
                        lbs.get(idx).set_y(y)
                        leaders.push(line.new(x_ldr, p, x_end, y, xloc=xloc.bar_time,
                                              color=cs.get(idx), style=ls(ss.get(idx)), width=ws.get(idx)))
                    k += 1
