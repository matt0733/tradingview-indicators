//@version=6
indicator("Opening Gaps 1.0.0", shorttitle="Opening Gaps", overlay=true,
          max_lines_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS — GENERAL
// ═══════════════════════════════════════════════════════════════════════════
string GEN = "『 GENERAL 』"
int ext_bars = input.int(20, "Extend Right (bars)", minval=0, maxval=500, group=GEN, display=display.none,
    tooltip="How far past the current bar every gap line reaches. Labels sit at the right end of the lines.")

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS — OPENING GAPS
// ═══════════════════════════════════════════════════════════════════════════
string GG = "『 OPENING GAPS 』"

bool   nw_on    = input.bool(true, "NWOG ▸", group=GG, display=display.none, inline="nw0")
int    nw_keep  = input.int(1, "Show Last:", minval=1, maxval=10, group=GG, display=display.none, inline="nw0",
    tooltip="New Week Opening Gap: Friday's 16:59 close to Sunday's 18:00 open (New York time). Quarter and mid levels are measured from the open toward the prior close, so 25% means the gap is a quarter filled.")
color  nw_lcol  = input.color(#673AB7, "Line ▸", group=GG, display=display.none, inline="nw1")
string nw_lsty  = input.string("Solid", "", options=["Solid","Dashed","Dotted"], group=GG, display=display.none, inline="nw1")
int    nw_lw    = input.int(2, "", minval=1, maxval=10, group=GG, display=display.none, inline="nw1")
color  nw_tcol  = input.color(#673AB7, "Text ▸", group=GG, display=display.none, inline="nw2")
string nw_tsz   = input.string("Small", "", options=["Tiny","Small","Normal","Large"], group=GG, display=display.none, inline="nw2")
string nw_tpos  = input.string("Middle", "", options=["Top","Middle","Bottom"], group=GG, display=display.none, inline="nw2")
bool   nw_mid   = input.bool(true, "Mid Line ▸", group=GG, display=display.none, inline="nw3")
string nw_msty  = input.string("Dotted", "", options=["Solid","Dashed","Dotted"], group=GG, display=display.none, inline="nw3")
int    nw_mw    = input.int(1, "", minval=1, maxval=10, group=GG, display=display.none, inline="nw3")
bool   nw_qtr   = input.bool(true, "Quarters ▸", group=GG, display=display.none, inline="nw4")
string nw_qsty  = input.string("Dotted", "", options=["Solid","Dashed","Dotted"], group=GG, display=display.none, inline="nw4")
int    nw_qw    = input.int(1, "", minval=1, maxval=10, group=GG, display=display.none, inline="nw4")

bool   nd_on    = input.bool(true, "NDOG ▸", group=GG, display=display.none, inline="nd0")
int    nd_keep  = input.int(1, "Show Last:", minval=1, maxval=10, group=GG, display=display.none, inline="nd0",
    tooltip="New Day Opening Gap: the 16:59 close to the 18:00 open, Monday through Thursday (New York time). Quarter and mid levels are measured from the open toward the prior close.")
color  nd_lcol  = input.color(#2962FF, "Line ▸", group=GG, display=display.none, inline="nd1")
string nd_lsty  = input.string("Solid", "", options=["Solid","Dashed","Dotted"], group=GG, display=display.none, inline="nd1")
int    nd_lw    = input.int(2, "", minval=1, maxval=10, group=GG, display=display.none, inline="nd1")
color  nd_tcol  = input.color(#2962FF, "Text ▸", group=GG, display=display.none, inline="nd2")
string nd_tsz   = input.string("Small", "", options=["Tiny","Small","Normal","Large"], group=GG, display=display.none, inline="nd2")
string nd_tpos  = input.string("Middle", "", options=["Top","Middle","Bottom"], group=GG, display=display.none, inline="nd2")
bool   nd_mid   = input.bool(true, "Mid Line ▸", group=GG, display=display.none, inline="nd3")
string nd_msty  = input.string("Dotted", "", options=["Solid","Dashed","Dotted"], group=GG, display=display.none, inline="nd3")
int    nd_mw    = input.int(1, "", minval=1, maxval=10, group=GG, display=display.none, inline="nd3")
bool   nd_qtr   = input.bool(true, "Quarters ▸", group=GG, display=display.none, inline="nd4")
string nd_qsty  = input.string("Dotted", "", options=["Solid","Dashed","Dotted"], group=GG, display=display.none, inline="nd4")
int    nd_qw    = input.int(1, "", minval=1, maxval=10, group=GG, display=display.none, inline="nd4")

bool   rt_on    = input.bool(true, "RTH Gap ▸", group=GG, display=display.none, inline="rt0")
int    rt_keep  = input.int(1, "Show Last:", minval=1, maxval=10, group=GG, display=display.none, inline="rt0",
    tooltip="Regular Trading Hours Opening Range Gap: the 16:14 close to the next 09:30 open, Monday through Friday (New York time). Quarter and mid levels are measured from the open toward the prior close. Futures holidays with no regular session (e.g. Labor Day) are skipped, so the next day's gap runs from the last real 16:14 close. Only drawn on timeframes that divide evenly into 15 minutes (1s–15m, e.g. 1, 3, 5, 15), since other bar sizes straddle 16:15 and would give the wrong close.")
color  rt_lcol  = input.color(#FF9800, "Line ▸", group=GG, display=display.none, inline="rt1")
string rt_lsty  = input.string("Solid", "", options=["Solid","Dashed","Dotted"], group=GG, display=display.none, inline="rt1")
int    rt_lw    = input.int(1, "", minval=1, maxval=10, group=GG, display=display.none, inline="rt1")
color  rt_tcol  = input.color(#FF9800, "Text ▸", group=GG, display=display.none, inline="rt2")
string rt_tsz   = input.string("Small", "", options=["Tiny","Small","Normal","Large"], group=GG, display=display.none, inline="rt2")
string rt_tpos  = input.string("Middle", "", options=["Top","Middle","Bottom"], group=GG, display=display.none, inline="rt2")
bool   rt_mid   = input.bool(true, "Mid Line ▸", group=GG, display=display.none, inline="rt3")
string rt_msty  = input.string("Dotted", "", options=["Solid","Dashed","Dotted"], group=GG, display=display.none, inline="rt3")
int    rt_mw    = input.int(1, "", minval=1, maxval=10, group=GG, display=display.none, inline="rt3")
bool   rt_qtr   = input.bool(true, "Quarters ▸", group=GG, display=display.none, inline="rt4")
string rt_qsty  = input.string("Dotted", "", options=["Solid","Dashed","Dotted"], group=GG, display=display.none, inline="rt4")
int    rt_qw    = input.int(1, "", minval=1, maxval=10, group=GG, display=display.none, inline="rt4")

// ═══════════════════════════════════════════════════════════════════════════
// TYPES
// ═══════════════════════════════════════════════════════════════════════════
type GapCfg
    string name
    bool   on
    int    keep
    color  lcol
    string lsty
    int    lw
    color  tcol
    string tsz
    string tpos
    bool   mid
    string msty
    int    mw
    bool   qtr
    string qsty
    int    qw

type Gap
    float        pc     // prior close
    int          pc_t
    float        op     // open
    int          op_t
    array<line>  lines
    array<label> labels

// ═══════════════════════════════════════════════════════════════════════════
// HELPERS
// ═══════════════════════════════════════════════════════════════════════════
ls(s) =>
    switch s
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        =>          line.style_solid

lbl_sz(s) =>
    switch s
        "Tiny"   => size.tiny
        "Normal" => size.normal
        "Large"  => size.large
        =>          size.small

lbl_sty(pos) =>
    switch pos
        "Top"    => label.style_label_lower_left
        "Bottom" => label.style_label_upper_left
        =>          label.style_label_left

draw_level(Gap g, GapCfg c, int x1, int x2, float y, string sty, int w, string txt) =>
    g.lines.push(line.new(x1, y, x2, y, xloc=xloc.bar_time, color=c.lcol, style=ls(sty), width=w))
    g.labels.push(label.new(x2, y, txt, xloc=xloc.bar_time, style=lbl_sty(c.tpos),
                            color=color.new(color.white, 100), textcolor=c.tcol,
                            size=lbl_sz(c.tsz), textalign=text.align_left))

// Draws one gap: High/Low from where each price was set, mid/quarters from the open.
// Percent levels run from the open toward the prior close (25% = a quarter filled).
draw_gap(GapCfg c, float pc, int pc_t, float op, int op_t, int x2) =>
    Gap g = Gap.new(pc, pc_t, op, op_t, array.new<line>(), array.new<label>())
    bool gap_dn = pc >= op
    draw_level(g, c, gap_dn ? pc_t : op_t, x2, math.max(pc, op), c.lsty, c.lw, c.name + " High")
    draw_level(g, c, gap_dn ? op_t : pc_t, x2, math.min(pc, op), c.lsty, c.lw, c.name + " Low")
    float span = pc - op
    if c.qtr
        draw_level(g, c, op_t, x2, op + span * 0.25, c.qsty, c.qw, "25%")
        draw_level(g, c, op_t, x2, op + span * 0.75, c.qsty, c.qw, "75%")
    if c.mid
        draw_level(g, c, op_t, x2, op + span * 0.5, c.msty, c.mw, "50%")
    g

clear_gap(Gap g) =>
    for l in g.lines
        l.delete()
    for lb in g.labels
        lb.delete()

// Adds a gap and trims the oldest beyond Show Last. Returns the gap trimmed, if any.
add_gap(GapCfg c, array<Gap> store, float pc, int pc_t, float op, int op_t, int x2) =>
    store.push(draw_gap(c, pc, pc_t, op, op_t, x2))
    Gap evicted = na
    while store.size() > c.keep
        evicted := store.shift()
        clear_gap(evicted)
    log.info("{0}: close {1} -> open {2} ({3} pts)", c.name,
             str.tostring(pc, format.mintick), str.tostring(op, format.mintick),
             str.tostring(op - pc, format.mintick))
    evicted

extend_all(array<Gap> store, int x2) =>
    for g in store
        for l in g.lines
            l.set_x2(x2)
        for lb in g.labels
            lb.set_x(x2)

// ═══════════════════════════════════════════════════════════════════════════
// STATE
// ═══════════════════════════════════════════════════════════════════════════
const string TZ = "America/New_York"

var GapCfg nw_cfg = GapCfg.new("NWOG", nw_on, nw_keep, nw_lcol, nw_lsty, nw_lw, nw_tcol, nw_tsz, nw_tpos,
                               nw_mid, nw_msty, nw_mw, nw_qtr, nw_qsty, nw_qw)
var GapCfg nd_cfg = GapCfg.new("NDOG", nd_on, nd_keep, nd_lcol, nd_lsty, nd_lw, nd_tcol, nd_tsz, nd_tpos,
                               nd_mid, nd_msty, nd_mw, nd_qtr, nd_qsty, nd_qw)
var GapCfg rt_cfg = GapCfg.new("RTH",  rt_on, rt_keep, rt_lcol, rt_lsty, rt_lw, rt_tcol, rt_tsz, rt_tpos,
                               rt_mid, rt_msty, rt_mw, rt_qtr, rt_qsty, rt_qw)

var array<Gap> nw_gaps = array.new<Gap>()
var array<Gap> nd_gaps = array.new<Gap>()
var array<Gap> rt_gaps = array.new<Gap>()

var float eve_close   = na    // last bar starting before 17:00
var int   eve_close_t = na

// RTH close is only carried forward from a real session. Holiday Globex sessions
// (Labor Day, Presidents Day, ...) still print a 09:30 bar but halt at 13:00, so a
// day counts only once it trades past 13:00 — early-close days run to 13:15.
var float rth_close   = na    // close before 16:15 of the last real RTH session
var int   rth_close_t = na
var float day_close   = na    // running close before 16:15 today
var int   day_close_t = na
var bool  day_real    = false // today traded past 13:00
var bool  rt_pending  = false // today's RTH gap is waiting on day_real
var Gap   rt_evicted  = na    // gap trimmed by today's, restored if today is a holiday

// ═══════════════════════════════════════════════════════════════════════════
// PROCESSING
// ═══════════════════════════════════════════════════════════════════════════
const int S_RTH_OPEN  = 9 * 3600 + 30 * 60
const int S_HOLIDAY   = 13 * 3600
const int S_RTH_CLOSE = 16 * 3600 + 15 * 60
const int S_HALT      = 17 * 3600
const int S_REOPEN    = 18 * 3600

int  tf_sec = timeframe.in_seconds()
bool tf_ok  = tf_sec < 86400
bool rth_ok = tf_ok and 900 % tf_sec == 0
int  sod    = hour(time, TZ) * 3600 + minute(time, TZ) * 60 + second(time, TZ)
int  dow    = dayofweek(time, TZ)
int  x_end  = time + ext_bars * tf_sec * 1000

// True only on the bar whose span contains the given second of the day
contains(int s) =>
    sod <= s and s < sod + tf_sec

if tf_ok
    // 18:00 reopen — Sunday is NWOG, Monday–Thursday is NDOG
    if contains(S_REOPEN) and not na(eve_close) and eve_close != open
        if dow == dayofweek.sunday and nw_cfg.on
            add_gap(nw_cfg, nw_gaps, eve_close, eve_close_t, open, time, x_end)
        else if dow >= dayofweek.monday and dow <= dayofweek.thursday and nd_cfg.on
            add_gap(nd_cfg, nd_gaps, eve_close, eve_close_t, open, time, x_end)
    if sod < S_HALT
        eve_close   := close
        eve_close_t := time

if rth_ok
    // 09:30 open, Monday–Friday
    if contains(S_RTH_OPEN) and dow >= dayofweek.monday and dow <= dayofweek.friday
        if day_real
            rth_close   := day_close
            rth_close_t := day_close_t
        day_real := false
        if rt_cfg.on and not na(rth_close) and rth_close != open
            rt_evicted := add_gap(rt_cfg, rt_gaps, rth_close, rth_close_t, open, time, x_end)
            rt_pending := true
    if sod >= S_RTH_OPEN and sod < S_RTH_CLOSE
        day_close   := close
        day_close_t := time
    if sod >= S_HOLIDAY and sod < S_HALT
        day_real   := true
        rt_pending := false
    else if rt_pending and (sod >= S_HALT or sod < S_RTH_OPEN)
        // Halted before 13:00: no regular session today, so drop its gap
        Gap g = rt_gaps.pop()
        clear_gap(g)
        if not na(rt_evicted)
            rt_gaps.unshift(draw_gap(rt_cfg, rt_evicted.pc, rt_evicted.pc_t, rt_evicted.op, rt_evicted.op_t, x_end))
        log.info("RTH: dropped holiday gap {0} -> {1}", str.tostring(g.pc, format.mintick), str.tostring(g.op, format.mintick))
        rt_pending := false

if barstate.islast
    extend_all(nw_gaps, x_end)
    extend_all(nd_gaps, x_end)
    extend_all(rt_gaps, x_end)
